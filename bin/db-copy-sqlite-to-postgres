#!/usr/bin/env ruby
# frozen_string_literal: true

# One-time move SQLite → PostgreSQL (lib/busyyaks/db_copy.rb; runbook: docs/DEPLOY.md § Switching SQLite → PostgreSQL).
# The target is the database the env names (DATABASE_ADAPTER=postgresql + POSTGRES_*); it must be EMPTY. The SQLite
# file is opened read-only. Every service stopped, the postgres service up:
#
#   docker compose run --rm --no-deps web bin/db-copy-sqlite-to-postgres --from /data/busyyaks.sqlite3
#
# Prints a line per table copied and verified (rows + SHA-256); exits non-zero, with the reason, on any refusal or
# difference — the copy is one transaction, so a failed run commits nothing of the file.
require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "busyyaks/db_copy"

usage = "usage: bin/db-copy-sqlite-to-postgres --from <SQLite file>"
abort usage unless ARGV.size == 2 && ARGV[0] == "--from"

begin
  target = Busyyaks::Database.from_env
  migrate = -> { system("bundle", "exec", "hanami", "db", "migrate", "--no-dump", exception: true) }
  reports = Busyyaks::DBCopy.new(source: ARGV[1], target: target, migrate: migrate).run
  puts "done: #{reports.size} tables, #{reports.sum(&:rows)} rows copied and verified into #{target.options[:database]}"
rescue Busyyaks::Database::Invalid, Busyyaks::DBCopy::Refused, Busyyaks::DBCopy::Mismatch => e
  abort "db-copy: #{e.message}"
end
