#!/bin/sh
# The Quickstart's steps before `docker compose up` (README § Quickstart), in POSIX sh: the dashboard needs no host
# Ruby (README § Requirements). Run from anywhere; it works on the checkout it lives in.
#
#   bin/setup          copies each example that is missing (.env, config/busyyaks.yml, config/kanban.yml — an existing
#                      file is kept, never overwritten), writes the secrets that are EMPTY in .env (SESSION_SECRET 64
#                      bytes, MCP_TOKEN, MCP_REPORT_TOKEN and MCP_BOARD_TOKEN 32 bytes, hex from /dev/urandom; a value already there is
#                      kept), HOST_UID / HOST_GID = this user into a .env it just copied, makes .env 0600, then lists
#                      every key compose requires that is still empty: fill those in .env.
#   bin/setup secrets  only the secrets of an existing .env: a missing line appended, an empty one written, a set one
#                      kept (what `yaks update` runs: a version that adds a secret never stops an update).
#   bin/setup check    every value compose requires is set (each empty one named), HOST_UID:HOST_GID is this user,
#                      PROJECTS_ROOT is an existing directory written as its real path, GIT_EXCLUDES_FILE an absolute
#                      path of a plain file (no symlink), LAUNCHER_RUN_DIR is absolute,
#                      .env is readable by you only; creates ./data and LAUNCHER_RUN_DIR (0700) as this user (and, with
#                      COMPOSE_PROFILES=postgres, ./data/postgres + ./data/postgres-run) — compose never creates them,
#                      and Docker would make them root's —, then `docker compose config -q` (compose's own reading).
#                      Exit 1 naming every problem and its fix; nothing after it runs: `bin/setup check && docker compose up …`.
#
# The required keys are read from docker-compose.yml itself (every `${KEY:?}`): one list, the file that needs them.
# Both refuse a .env that lib/busyyaks/env_file.rb (bin/launcher, bin/env, `yaks doctor`) would refuse: a line that is
# not KEY=value, a key given twice, a `$`, an inline ` #` comment, an unquoted value with a space, an unclosed quote or
# a quote inside the value, a backslash inside double quotes — so `check` never says ok for a file the launcher then
# stops on. Values are read as plain KEY=value / KEY="value" lines.
set -eu

# the app's own minimums, refused at its boot (test/unit/setup_test.rb holds them equal to the Ruby constants)
MIN_SESSION_SECRET_BYTES=64   # lib/busyyaks/session_cookie.rb SessionCookie::MIN_SECRET_BYTES
MIN_MCP_TOKEN_CHARS=32        # lib/busyyaks/mcp_server.rb McpServer::MIN_TOKEN_CHARS (MCP_TOKEN, MCP_REPORT_TOKEN, MCP_BOARD_TOKEN)
# the .env keys moved to Settings → Runtime (lib/busyyaks/runtime_settings.rb RuntimeSettings::KEYS): `check`
# refuses a .env that still has one
# the git host's keys moved to Settings → Git hosts (lib/busyyaks/git_hosts.rb): `check` refuses a .env that
# still has one, naming the one-time import
GIT_HOSTS_MOVED="GITHUB_LOGIN GITHUB_TOKEN"
RUNTIME_MOVED="SCAN_INTERVAL_SECONDS WRITER_SYNC_SECONDS GITHUB_INTERVAL_SECONDS GITHUB_CI_INTERVAL_SECONDS NOTIFIER_INTERVAL_SECONDS NOTIFIER_WATCH_SECONDS WATCHDOG_GRACE_SECONDS"

dir=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$dir"
env_file=.env

say() { printf '%s\n' "$*"; }
die() { printf 'bin/setup: %s\n' "$*" >&2; exit 1; }

# .env's value of KEY: the last KEY= line, one pair of surrounding quotes dropped; nothing → empty
value() {
  v=$(sed -n "s/^$1=//p" "$env_file" | tail -n 1)
  case "$v" in
    \"*\") v=${v#\"}; v=${v%\"} ;;
    \'*\') v=${v#\'}; v=${v%\'} ;;
  esac
  printf '%s' "$v"
}

# replaces KEY's line in .env with KEY=VALUE; .env keeps its mode. The value reaches awk through its environment, never
# its argv (a secret on a command line is readable in /proc/<pid>/cmdline by every local user)
put() {
  (umask 077 && SETUP_KEY=$1 SETUP_VALUE=$2 awk 'BEGIN { k = ENVIRON["SETUP_KEY"] "=" }
    index($0, k) == 1 { print k ENVIRON["SETUP_VALUE"]; next } { print }' "$env_file" > "$env_file.tmp")
  cat "$env_file.tmp" > "$env_file"
  rm -f "$env_file.tmp"
}

# what EnvFile refuses, one "line N: why" per problem (nothing = the file's shape is fine)
shape() {
  grep -nvE '^[[:space:]]*(#|$)|^[A-Za-z_][A-Za-z0-9_]*=' "$env_file" | sed 's/^\([0-9]*\):.*/line \1: not KEY=value/' || true
  grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$env_file" | sort | uniq -d | sed 's/=$//; s/^/a key given twice: /' || true
  grep -nE '^[A-Za-z_][A-Za-z0-9_]*=.*[$]' "$env_file" | sed 's/^\([0-9]*\):\([^=]*\)=.*/line \1: \2 holds a dollar sign (no interpolation: write the value out)/' || true
  grep -nE '^[A-Za-z_][A-Za-z0-9_]*=[^"'"'"'].*[[:space:]]' "$env_file" \
    | sed 's/^\([0-9]*\):\([^=]*\)=.*/line \1: \2: an unquoted value with a space or an inline " #" comment (quote it; comments on their own line)/' || true
  grep -nE '^[A-Za-z_][A-Za-z0-9_]*=["'"'"']' "$env_file" \
    | grep -vE '^[0-9]+:[A-Za-z_][A-Za-z0-9_]*=("[^"'"'"']*"|'"'"'[^"'"'"']*'"'"')$' \
    | sed 's/^\([0-9]*\):\([^=]*\)=.*/line \1: \2: an unclosed quote, a quote inside the value, or text after the closing quote/' || true
  grep -nE '^[A-Za-z_][A-Za-z0-9_]*="[^"]*[\\]' "$env_file" \
    | sed 's/^\([0-9]*\):\([^=]*\)=.*/line \1: \2: a backslash inside double quotes (escapes are not supported)/' || true
}

# config/busyyaks.yml agents.collector as bin/setup reads it (the example's block layout): "none", or one
# "snapshot <path>" / "read_socket <path>" line each (a trailing comment dropped; quotes kept, stripped by the caller)
collector_conf() {
  awk '
    /^[^[:space:]#]/ { a = ($0 ~ /^agents:/); if (a && $0 ~ /collector:[[:space:]]*none/) { print "none"; exit }; next }
    a && /^[[:space:]]+collector:[[:space:]]*none([[:space:]]|$)/ { print "none"; exit }
    a && /^[[:space:]]+(snapshot|read_socket):/ {
      k = $1; sub(/:$/, "", k); v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); sub(/[[:space:]]+#.*$/, "", v); print k " " v
    }
  ' config/busyyaks.yml
}

# a fresh config/busyyaks.yml: the example's /home/you/ collector paths → this user's $HOME (as HOST_UID: this user)
collector_home() {
  case "${HOME:-}" in
    /*) ;;
    *) die "HOME is not an absolute path (got '${HOME:-}'): bin/setup writes agents.collector's paths under it" ;;
  esac
  (umask 077 && SETUP_HOME=${HOME%/} awk '/^[[:space:]]+(snapshot|read_socket):[[:space:]]*\/home\/you\// {
      sub(/\/home\/you\//, ENVIRON["SETUP_HOME"] "/") } { print }' config/busyyaks.yml > config/busyyaks.yml.tmp)
  cat config/busyyaks.yml.tmp > config/busyyaks.yml
  rm -f config/busyyaks.yml.tmp
  say "wrote    agents.collector paths under $HOME (config/busyyaks.yml; collector: none for no agents sidebar)"
}

# N random bytes as hex
secret() { od -An -v -tx1 -N "$1" /dev/urandom | tr -d ' \n'; }

# every ${KEY:?} of docker-compose.yml (comment lines skipped)
required() {
  grep -v '^[[:space:]]*#' docker-compose.yml | grep -o '[$]{[A-Z0-9_]*:?' | sed 's/^[$]{//; s/:?$//' | sort -u
}

# the required keys that are empty (or absent) in .env, one per line
empty_required() {
  for k in $(required); do
    [ -n "$(value "$k")" ] || say "$k"
  done
}

# LauncherRules.run_dir!'s rules (lib/busyyaks/launcher_rules.rb) that hold before the dir exists, so `check` never
# makes a dir bin/launcher then refuses: outside PROJECTS_ROOT, this checkout and ./data (and not around them); every
# existing ancestor a real dir (no symlink), this user's or root's, not writable by group / other (a sticky /tmp too:
# another user could create the dir first after a reboot). The rest (its parent this user's, the dir 0700) after mkdir.
run_dir_rules() {
  r=$1 projects=$2
  for o in "$projects" "$dir" "$dir/data"; do
    [ -n "$o" ] || continue
    case "$r/" in "$o"/*) bad "LAUNCHER_RUN_DIR $r is inside $o: every container mounts it; put it outside"; continue ;; esac
    case "$o/" in "$r"/*) bad "LAUNCHER_RUN_DIR $r holds $o: every container mounts that; put it outside" ;; esac
  done
  [ ! -L "$r" ] || bad "LAUNCHER_RUN_DIR $r is a symlink: write its real path"
  a=$(dirname "$r")
  while :; do
    if [ -L "$a" ]; then
      bad "LAUNCHER_RUN_DIR $r: $a is a symlink: write the real path"
    elif [ -e "$a" ]; then
      u=$(stat -c %u "$a") m=$(stat -c %a "$a")
      if [ "$u" != "$(id -u)" ] && [ "$u" != 0 ]; then
        bad "LAUNCHER_RUN_DIR $r: its parent $a is owned by uid $u, not $(id -u) or root"
      elif [ $((0$m & 18)) -ne 0 ]; then
        bad "LAUNCHER_RUN_DIR $r: its parent $a is writable by group / other (mode $m): pick a dir of yours, e.g. ~/.local/state/busyyaks/run"
      fi
    fi
    [ "$a" != / ] || break
    a=$(dirname "$a")
  done
}

# the secrets in .env: a missing line is appended (a key a newer busyyaks added), an empty one written; a value
# already there is kept. `bin/setup` runs it; so does `yaks update` (`bin/setup secrets`) before it moves the stack
secrets() {
  for pair in SESSION_SECRET:64 MCP_TOKEN:32 MCP_REPORT_TOKEN:32 MCP_BOARD_TOKEN:32; do
    k=${pair%%:*} n=${pair#*:}
    # a secret a newer busyyaks added (an .env written by an older one has no line for it): the line is appended,
    # then filled below like any empty one — an update never stops on a key it can make itself
    if ! grep -q "^$k=" "$env_file"; then
      # a last line with no newline would swallow the new key into its value
      [ -z "$(tail -c 1 "$env_file")" ] || printf '\n' >> "$env_file"
      printf '%s=\n' "$k" >> "$env_file"
      say "added    $k= (new in this version)"
    fi
    if [ -n "$(value "$k")" ]; then
      say "kept     $k (set)"
    else
      put "$k" "$(secret "$n")"
      say "wrote    $k ($n random bytes, hex)"
    fi
  done
}

init() {
  fresh=
  for pair in .env.example:.env config/busyyaks.example.yml:config/busyyaks.yml config/kanban.example.yml:config/kanban.yml; do
    from=${pair%%:*} to=${pair#*:}
    if [ -e "$to" ]; then
      say "kept     $to (already there)"
    else
      cp "$from" "$to"
      say "copied   $from → $to"
      if [ "$to" = .env ]; then
        chmod 600 .env   # it holds the secrets
        fresh=1
      fi
      [ "$to" != config/busyyaks.yml ] || collector_home
    fi
  done
  bad_shape=$(shape)
  [ -z "$bad_shape" ] || die "$env_file: $(printf '%s' "$bad_shape" | paste -sd ';' | sed 's/;/; /g') — fix it, then run bin/setup again"
  if [ "$(stat -c %a "$env_file")" != 600 ]; then
    chmod 600 "$env_file"
    say "chmod    .env 600 (it holds the secrets)"
  fi
  secrets
  if [ -n "$fresh" ]; then
    put HOST_UID "$(id -u)"
    put HOST_GID "$(id -g)"
    say "wrote    HOST_UID=$(id -u) HOST_GID=$(id -g) (this user: the containers run as it)"
  fi
  left=$(empty_required)
  if [ -n "$left" ]; then
    say ""
    say "Fill in .env (each is explained above its line there), then: bin/setup check"
    for k in $left; do say "  $k"; done
  else
    say ""
    say "Every value compose requires is set. Next: bin/setup check"
  fi
}

check() {
  problems=0
  bad() { printf 'FAIL  %s\n' "$*" >&2; problems=$((problems + 1)); }
  for f in .env config/busyyaks.yml config/kanban.yml; do
    [ -f "$f" ] || { bad "$f is missing: run bin/setup"; }
  done
  [ "$problems" -eq 0 ] || exit 1

  bad_shape=$(shape)
  if [ -n "$bad_shape" ]; then
    while IFS= read -r line; do bad ".env $line"; done <<SHAPE
$bad_shape
SHAPE
  fi
  case "$(stat -c %a .env)" in
    600 | 400) ;;
    *) bad ".env has mode $(stat -c %a .env) and holds the secrets: chmod 600 .env" ;;
  esac

  for k in $(empty_required); do
    case "$k" in
      SESSION_SECRET | MCP_TOKEN | MCP_REPORT_TOKEN | MCP_BOARD_TOKEN) bad "$k is empty in .env: run bin/setup (it writes the secrets)" ;;
      *) bad "$k is empty in .env: fill it (its comment in .env says what it is)" ;;
    esac
  done
  # every secret / token rule a service refuses to boot on: SessionCookie (web), McpServer (mcp), Database (every
  # service: the adapter's keys), Dictation (web: the token's characters)
  s=$(value SESSION_SECRET)
  if [ -n "$s" ] && [ "${#s}" -lt "$MIN_SESSION_SECRET_BYTES" ]; then
    bad "SESSION_SECRET is ${#s} bytes, the web app needs at least $MIN_SESSION_SECRET_BYTES: empty it in .env and run bin/setup"
  fi
  t=$(value MCP_TOKEN) r=$(value MCP_REPORT_TOKEN) b=$(value MCP_BOARD_TOKEN)
  for pair in "MCP_TOKEN:$t" "MCP_REPORT_TOKEN:$r" "MCP_BOARD_TOKEN:$b"; do
    k=${pair%%:*} v=${pair#*:}
    if [ -n "$v" ] && [ "${#v}" -lt "$MIN_MCP_TOKEN_CHARS" ]; then
      bad "$k is ${#v} characters, the MCP server needs at least $MIN_MCP_TOKEN_CHARS: empty it in .env and run bin/setup"
    fi
  done
  if [ -n "$r" ] && [ "$r" = "$t" ]; then
    bad "MCP_REPORT_TOKEN equals MCP_TOKEN, the MCP server refuses that: empty it in .env and run bin/setup"
  fi
  if [ -n "$b" ] && { [ "$b" = "$t" ] || [ "$b" = "$r" ]; }; then
    bad "MCP_BOARD_TOKEN equals MCP_TOKEN or MCP_REPORT_TOKEN, the MCP server refuses that: empty it in .env and run bin/setup"
  fi
  if [ "$(value DATABASE_ADAPTER)" = postgresql ]; then
    for k in POSTGRES_HOST POSTGRES_PORT POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD POSTGRES_LOCK_TIMEOUT_MS; do
      [ -n "$(value "$k")" ] || bad "$k is empty in .env: DATABASE_ADAPTER=postgresql needs it (.env group 5, Database)"
    done
  fi
  case "$(value DICTATION_TOKEN)" in
    *[[:space:]]* | *[[:cntrl:]]*) bad "DICTATION_TOKEN has whitespace or control characters: the web app refuses it" ;;
  esac
  # the services' timing moved to Settings → Runtime (the database): a line left here would look like it
  # still sets something; no service reads it
  for k in $RUNTIME_MOVED; do
    # an `export KEY=` line is refused above already (not KEY=value), like EnvFile does
    if grep -q "^[[:space:]]*$k=" .env; then
      bad "$k moved to Settings → Runtime: start web alone (docker compose up -d --wait web: it migrates)," \
        "import your values (docker compose exec -T web bin/runtime-settings import-env < .env), then delete the line" \
        "from .env (docs/DEPLOY.md § Runtime settings)"
    fi
  done

  # the git host (GitHub login + token) moved to Settings → Git hosts: the token now lives only in the
  # github service's own volume; a line left here would look like it still connects GitHub
  for k in $GIT_HOSTS_MOVED; do
    if grep -q "^[[:space:]]*$k=" .env; then
      bad "$k moved to Settings → Git hosts: connect GitHub there, or import these lines once" \
        "(docker compose up -d --wait web github, then docker compose exec -T github bin/git-hosts import-env < .env)," \
        "then delete GITHUB_LOGIN and GITHUB_TOKEN from .env (docs/DEPLOY.md § Git hosts)"
    fi
  done

  # agents.collector (README § Agent sessions): bin/collector and bin/launcher refuse a path they cannot use; named here,
  # before deploy/install-collector.sh would stop on a bare mkdir. The full reading is `bin/collector --check` (host Ruby)
  conf=$(collector_conf)
  if [ "$conf" != none ]; then
    for k in snapshot read_socket; do
      p=$(printf '%s\n' "$conf" | sed -n "s/^$k //p" | tail -n 1)
      case "$p" in \"*\") p=${p#\"}; p=${p%\"} ;; \'*\') p=${p#\'}; p=${p%\'} ;; esac
      case "$p" in
        '') bad "config/busyyaks.yml agents.collector.$k not found (bin/setup reads the example's block layout): set it, or \`collector: none\`" ;;
        /home/you/*) [ "${HOME:-}" = /home/you ] || bad "config/busyyaks.yml agents.collector.$k is the example's $p: put it under your home (${HOME:-~}/.local/state/busyyaks/collector/), or \`collector: none\`" ;;
        /*)
          a=$(dirname "$p")
          while [ ! -e "$a" ]; do a=$(dirname "$a"); done
          { [ -d "$a" ] && [ -w "$a" ]; } \
            || bad "config/busyyaks.yml agents.collector.$k $p: its dir cannot be created by you ($a is not a dir you can write): pick a dir of yours, or \`collector: none\`"
          ;;
        *) bad "config/busyyaks.yml agents.collector.$k must be an absolute path (got $p)" ;;
      esac
    done
  fi

  uid=$(value HOST_UID) gid=$(value HOST_GID)
  if [ -n "$uid$gid" ] && [ "$uid:$gid" != "$(id -u):$(id -g)" ]; then
    bad "HOST_UID:HOST_GID is $uid:$gid, this user is $(id -u):$(id -g): set them to \`id -u\` / \`id -g\` of the user that runs bin/launcher"
  fi

  root=$(value PROJECTS_ROOT)
  if [ -n "$root" ]; then
    if [ ! -d "$root" ]; then
      bad "PROJECTS_ROOT $root is not a directory: the directory that holds your git repos"
    elif [ "$(cd "$root" && pwd -P)" != "$root" ]; then
      bad "PROJECTS_ROOT $root is not its real path: write $(cd "$root" && pwd -P) (no symlink, no trailing /)"
    fi
  fi

  # the global git excludes every service mounts (card #280): compose mounts it as written, so a symlink is refused
  excl=$(value GIT_EXCLUDES_FILE)
  case "$excl" in
    '') ;;
    /*)
      if [ -L "$excl" ]; then
        bad "GIT_EXCLUDES_FILE $excl is a symlink: write the file it points at"
      elif [ ! -f "$excl" ]; then
        bad "GIT_EXCLUDES_FILE $excl is not a file: the file \`git config --global core.excludesFile\` names, else ~/.config/git/ignore written out; none → an empty file you create"
      fi ;;
    *) bad "GIT_EXCLUDES_FILE $excl is not an absolute path" ;;
  esac

  run=$(value LAUNCHER_RUN_DIR)
  case "$run" in
    '') ;;
    /*)
      run_dir_rules "$run" "$root"
      if [ "$problems" -eq 0 ]; then
        # created 0700 when missing, its missing parents too: under the login umask (Ubuntu: 002, user-private groups) a
        # bare mkdir -p left them group-writable, and bin/launcher refused the dir this made (card #573); an existing one
        # is left as it is (bin/launcher refuses one open to others, never repairs)
        if [ ! -d "$run" ] && ! (umask 077 && mkdir -p "$(dirname "$run")" && mkdir "$run"); then
          bad "LAUNCHER_RUN_DIR $run cannot be created"
        elif [ "$(stat -c %u "$(dirname "$run")")" != "$(id -u)" ]; then
          bad "LAUNCHER_RUN_DIR $run: its parent $(dirname "$run") is owned by uid $(stat -c %u "$(dirname "$run")"), not $(id -u)"
        elif [ "$(stat -c %u "$run")" != "$(id -u)" ]; then
          bad "LAUNCHER_RUN_DIR $run is owned by uid $(stat -c %u "$run"), not $(id -u): chown it, or pick another dir"
        elif [ $((0$(stat -c %a "$run") & 63)) -ne 0 ]; then
          bad "LAUNCHER_RUN_DIR $run is mode $(stat -c %a "$run"): open to group / other; check what is in it, then chmod 700 $run"
        fi
      fi
      ;;
    *) bad "LAUNCHER_RUN_DIR must be an absolute path, written out (got $run)" ;;
  esac

  if [ "$problems" -eq 0 ]; then
    # made 0700 under any login umask (Ubuntu: 002): the database lives here (card #573)
    (umask 077 && mkdir -p data)
    # the compose postgres service's binds (docker-compose.yml postgres): this user's too, before its first start
    case ",$(value COMPOSE_PROFILES)," in *,postgres,*) (umask 077 && mkdir -p data/postgres data/postgres-run) ;; esac
    [ "$(stat -c %u data)" = "$(id -u)" ] \
      || bad "./data is owned by uid $(stat -c %u data), not $(id -u): sudo chown -R $(id -u):$(id -g) data"
  fi

  if ! command -v docker > /dev/null; then
    bad "docker is not on PATH: install Docker with the compose plugin (README § Requirements)"
  elif [ "$problems" -eq 0 ]; then
    docker compose config -q || bad "docker compose config refused .env (its message is above)"
  fi

  if [ "$problems" -gt 0 ]; then
    printf '%s problem(s): fix them, then bin/setup check again\n' "$problems" >&2
    exit 1
  fi
  say "ok    .env complete · ./data and $run ready · docker compose config ok"
  say "Next: docker compose up -d --build --wait web mcp scanner github notifier writer"
}

case "${1:-}" in
  '') init ;;
  check) check ;;
  secrets) [ -f "$env_file" ] || die "$env_file is missing: run bin/setup"; secrets ;;
  *) say "usage: bin/setup [check|secrets]" >&2; exit 2 ;;
esac
