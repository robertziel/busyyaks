#!/usr/bin/env ruby
# frozen_string_literal: true

# Scans every repo, then sleeps scan_interval_seconds (Settings → Runtime, read each turn), forever. A
# failed scan is recorded (scans.error, shown on the dashboard) and the loop keeps going; it never invents data.
require "hanami/prepare"
require "busyyaks/config"
require "busyyaks/scanner"
require "busyyaks/store"
require "busyyaks/clock"
require "busyyaks/runtime_settings"

config = Busyyaks::Config.load
store = Busyyaks::Store.default
$stdout.sync = true
loop do
  t = Busyyaks::Clock.monotonic
  begin
    n = Busyyaks::Scanner.new(config, store).run
    puts "scan ok repos=#{n} seconds=#{(Busyyaks::Clock.monotonic - t).round(1)}"
  rescue StandardError => e
    puts "scan FAILED #{e.class}: #{e.message}"
  end
  break if ENV["SCAN_ONCE"] == "1"

  sleep Busyyaks::RuntimeSettings.get(Hanami.app["db.gateway"].connection)[:scan_interval_seconds]
end
