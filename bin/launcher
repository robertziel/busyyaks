#!/usr/bin/env ruby
# frozen_string_literal: true

# every file this program reads is UTF-8 (.env, config/*.yml, skills, screens), never the locale's encoding: on a host
# with no UTF-8 locale (LANG unset → US-ASCII) it broke on the first non-ASCII byte (scripts/ci/host-distros)
Encoding.default_external = Encoding::UTF_8

# Host-side launcher (systemd --user, deploy/busyyaks-launcher.service). The web container cannot
# reach the host's tmux, so it asks this process over a unix socket in .env LAUNCHER_RUN_DIR (bind-mounted
# into the web, mcp and notifier containers only — never under ./data, which every container mounts). One JSON request per connection:
#   {"op":"name","base":"x_teamlead"}               → {"ok":true,"session":"x_teamlead_2"}   the engine's name, made free
#   {"op":"launch","path":"/projects/x","session":"x_2","type":"lead","launcher":"fullclaude","vars":{...}}
#                                                  → {"ok":true,"session":"x_2",...}  the engine registered x_2 first (Api#launch)
#   {"op":"sessions"}                                                      → {"ok":true,"sessions":[...]}
#   {"op":"lead_key","session":"x_teamlead"}       → {"ok":true,"key":…}  only for a lead THIS launcher started, while
#                                                    it runs (the engine's lead check for kanban_spawn)
#   {"op":"project_skills","path":"/projects/x","settings":{...}} → {"ok":true,"project_skills":"loaded"|"none"|"left: <why>",
#                                                    "budget","replace_budget":{type: bytes},"layers":{type:
#                                                    composition},"checkout":bool}  what a launch there does
#                                                    with the repo's .busyyaks/skills (every type planned, nothing started)
#   {"op":"skills_layers","settings":{...}}      → {"ok":true,"files":[{path,source,kind,load,skill,description,bytes,
#                                                    text}],"types":{type:{start,on_demand,start_bytes,budget}},
#                                                    "creatable":[paths],"checkout":{host,mount,error},"limits":{...}}
#                                                    busyyaks's own skills layers of THIS checkout, as a launch reads
#                                                    them (Skills.global_view; Settings → Agent rules), nothing started
#   {"op":"create","root":"/projects","name":"x","url":""}               → {"ok":true,"path":"/projects/x"}
#   {"op":"jobs"}                                                          → clone jobs with status + log tail
#   {"op":"agents"}                                → coding-agent sessions (agent_engines collector snapshot)
#   {"op":"agent_tasks","session":"x","socket":"default"} → that session's subagents/workflows/tasks
#   {"op":"reap_preview"}                          → agent sessions that are not working (stop candidates)
#   {"op":"reap","sessions":[{"name","socket"}]}   → stop those still eligible in a fresh snapshot
#   {"op":"stop","path","sessions":[names]}       → kill those sessions of that project (operator Stop / Stop all)
#   {"op":"notify","session","socket","text"}      → type a card ping into that Claude session (collector "send")
#   {"op":"dialog","session","socket"}              → the dialog on its screen now (SessionDialog.parse) or null
#   {"op":"git","session","socket"}                  → {"ok":true,"path"} the session's working dir, relative to PROJECTS_ROOT
#   {"op":"answer","session","socket","hash","key"} → press that option key (digit / esc) ONLY while the same dialog shows
#   {"op":"attach","session","socket"}              → the session's live terminal: {ok,session,cols,rows,screen}, then the
#                                                    connection stays open, JSON lines both ways (Busyyaks::Terminal)
#   {"op":"browse","path"}                          → that host dir's subdirs for the hello screen's picker (card 532)
#   {"op":"projects_root","step":"plan","path"}     → the checked plan to make path PROJECTS_ROOT + its plan_id
#   {"op":"projects_root","step":"apply","path","plan_id"} → .env rewritten, compose recreated, then this launcher exits
#                                                    (systemd restarts it on the new .env); {"step":"status"} → the
#                                                    current root + the last apply's record (state dir projects-root.json)
#   {"op":"update","step":"status"}                 → this checkout vs config/busyyaks.yml updates (card 536): the last
#                                                    check (re-checked on a thread when older than check_minutes or HEAD
#                                                    moved), the running / last update's record (state dir update.json)
#   {"op":"update","step":"check"}                  → a check now (`bin/yaks update --check --json`, hardened git: Updates::GIT_ENV)
#   {"op":"update","step":"apply","mode":"tags|branch","sha"} → `bin/yaks update` started detached (it outlives this
#                                                    launcher's restart: the unit's KillMode=process), refused unless
#                                                    sha is still that mode's target and the update is allowed
# agents · agent_tasks · reap_preview · reap · notify read the agent-session collector (AgentCollector::OPS); with
# config/busyyaks.yml agents.collector: none each answers {ok:false, unsupported:true, error: AgentCollector::OFF, status: 422}.
# Only an agent type + launcher key from config/kanban.yml (the board config's `agent_types` / `launchers`, built
# into an argv by the engine's Launch — the ONE place a launch is defined; the type's prompt template rendered with
# the engine's values + {dir}), only a git repo under PROJECTS_ROOT; create only inside a configured root, a safe
# name, an https:// or git@ URL. Nothing else runs.
require "socket"
require "json"
require "yaml"
require "open3"
require "shellwords"
require "fileutils"
require "time"
require "tmpdir"
require "pty"
require "io/console"
# base64 = pack("m0"), never the base64 library: Ruby 3.4 made it a bundled gem a distro's ruby may lack (Alpine's)
require_relative "../lib/busyyaks/clock"
# the engine files the host side loads: the dialog parser (the same the container runs, so both compute the same
# dialog hash) and the host config + Launch (how a session is started — config/kanban.yml's launchers and agent types)
require_relative "../vendor/agents_kanban/ruby/lib/agents_kanban/session_dialog"
require_relative "../vendor/agents_kanban/ruby/lib/agents_kanban/host_config"
require_relative "../vendor/agents_kanban/ruby/lib/agents_kanban/launch"
# herdr's screen-state rules (blocked / working / idle), ported: pure Ruby, the same file the container loads
require_relative "../lib/busyyaks/engines"
# config/busyyaks.yml `agents.collector`: none, or the collector's snapshot + read socket (checked at start)
require_relative "../lib/busyyaks/agent_collector"
# the one .env reader (bin/render-deploy and bin/env use it too)
require_relative "../lib/busyyaks/env_file"
require_relative "../lib/busyyaks/private_socket"
require_relative "../lib/busyyaks/launcher_rules"
require_relative "../lib/busyyaks/launch_trust"
require_relative "../lib/busyyaks/agent_settings"
# the skills every launch hands its session: busyyaks's own + the project's, staged per launch
require_relative "../lib/busyyaks/skills"
# the live terminal's stream: its frames, names and limits — the same file the web relays it with
require_relative "../lib/busyyaks/terminal"
# the agent harnesses the hello screen looks for (config/harnesses.yml)
require_relative "../lib/busyyaks/harnesses"
# the projects dir chosen from the hello screen (card 532): the checks, the .env rewrite, the apply's record
require_relative "../lib/busyyaks/projects_root"
# updating this checkout (card 536): the check, the records; the update itself is bin/yaks update
require_relative "../lib/busyyaks/updates"
require "rbconfig"

$stdout.sync = true
ROOT = File.expand_path("..", __dir__)
ENV_FILE = begin
  Busyyaks::EnvFile.read(File.join(ROOT, ".env"))
rescue Busyyaks::EnvFile::Invalid => e
  abort e.message
end

PROJECTS_ROOT = ENV_FILE.fetch("PROJECTS_ROOT") { abort "PROJECTS_ROOT missing in .env" }
# where compose mounts PROJECTS_ROOT inside the containers: the paths the web app sends are under it
CONTAINER_ROOT = ENV_FILE.fetch("PROJECTS_MOUNT") { abort "PROJECTS_MOUNT missing in .env" }
abort "PROJECTS_MOUNT in .env must be an absolute path without a trailing / (got #{CONTAINER_ROOT.inspect})" \
  unless CONTAINER_ROOT.match?(%r{\A/[^/]}) && !CONTAINER_ROOT.end_with?("/")
# the socket's own dir (.env LAUNCHER_RUN_DIR): only the containers that ask the launcher mount it. Its real path,
# created 0700, never under / around PROJECTS_ROOT or this checkout, owned by this uid (LauncherRules.run_dir!)
RUN_DIR = begin
  Busyyaks::LauncherRules.run_dir!(ENV_FILE.fetch("LAUNCHER_RUN_DIR") { abort "LAUNCHER_RUN_DIR missing in .env" },
                                   projects_root: PROJECTS_ROOT, checkout: ROOT, uid: Process.uid)
rescue Busyyaks::LauncherRules::Invalid => e
  abort e.message
end
SOCKET = File.join(RUN_DIR, "launcher.sock")
# Folder trust (LaunchTrust), read once at start; a bad value stops the start. TRUSTED = config/busyyaks.yml
# launch.trusted_paths on this host (real paths); CREATED = the repos this launcher's create made, in .env
# LAUNCHER_STATE_DIR (a dir only the launcher touches: no container mounts it).
TRUSTED, CREATED, STATE_DIR = begin
  trust = Busyyaks::LaunchTrust
  paths = trust.parse!(YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml"))["launch"])
  trusted = trust.host_paths!(trust.under_mount!(paths, CONTAINER_ROOT), container_root: CONTAINER_ROOT,
                                                                         projects_root: PROJECTS_ROOT)
  state = trust.state_dir!(ENV_FILE.fetch("LAUNCHER_STATE_DIR") { abort "LAUNCHER_STATE_DIR missing in .env" },
                           mounted: { "PROJECTS_ROOT" => PROJECTS_ROOT, "the busyyaks checkout" => ROOT,
                                      "./data" => File.join(ROOT, "data"), "the launcher socket dir" => RUN_DIR, },
                           uid: Process.uid)
  [trusted, trust::Created.new(state), state]
rescue Busyyaks::LaunchTrust::Invalid => e
  abort "folder trust: #{e.message}"
end
# The leads this launcher started (LauncherRules::Leads), in the same launcher-only state dir.
LEADS = begin
  Busyyaks::LauncherRules::Leads.new(STATE_DIR)
rescue Busyyaks::LauncherRules::Invalid => e
  abort "lead records: #{e.message}"
end
# The Hermes sessions this launcher started in queue mode with the busyyaks MCP (HermesBoard): only those
# take a typed ping.
HERMES_BOARD = begin
  Busyyaks::HermesBoard::Records.new(STATE_DIR)
rescue Busyyaks::HermesBoard::Invalid => e
  abort "hermes board records: #{e.message}"
end
# config/busyyaks.yml launch.start_seconds (required, LauncherRules.start_seconds!): how long a launch waits for its
# agent to come up while the launcher's command still runs; a bad or missing value stops the start.
START_SECONDS = begin
  launch_cfg = YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml"))["launch"]
  Busyyaks::LauncherRules.start_seconds!(launch_cfg.is_a?(Hash) ? launch_cfg["start_seconds"] : nil)
rescue Busyyaks::LauncherRules::Invalid => e
  abort "config/busyyaks.yml: #{e.message}"
end
# config/busyyaks.yml skills (required, Skills.settings!): the size limits, whether a repo's .busyyaks skills may load,
# the deployment's own skills dir. Each launch stages its session's skills under STAGES/<session> (0700, the launcher's
# own state dir: no container mounts it); a stage whose session is gone is removed at the next launch and at start.
SKILLS = begin
  Busyyaks::Skills.settings!(YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml"))["skills"])
rescue Busyyaks::Skills::Invalid => e
  abort "config/busyyaks.yml: #{e.message}"
end
STAGES = File.join(STATE_DIR, "skills")
FileUtils.mkdir_p(STAGES, mode: 0o700)
# launches run on their own threads: a sweep never removes the stage of a launch still in flight
STAGE_LOCK = Mutex.new
IN_FLIGHT = []
# config/busyyaks.yml launch.scopes (required key, LauncherRules.scopes!): null or each session in its own
# systemd user scope — a lead's with the oomd preference, the others' with a memory cap.
SCOPES = begin
  launch_cfg = YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml"))["launch"]
  abort "config/busyyaks.yml: launch.scopes is required (null = no systemd user manager on this host)" \
    unless launch_cfg.is_a?(Hash) && launch_cfg.key?("scopes")
  Busyyaks::LauncherRules.scopes!(launch_cfg["scopes"])
rescue Busyyaks::LauncherRules::Invalid => e
  abort "config/busyyaks.yml: #{e.message}"
end
%w[AGENTS_SNAPSHOT AGENTS_READ_SOCKET].each do |k|
  abort "#{k} is in .env: the collector moved to config/busyyaks.yml agents.collector — remove it from .env" if ENV_FILE.key?(k)
end
# The agent-session collector this box runs, stated in config/busyyaks.yml `agents` (no default): nil = none — every op
# that needs it answers AgentCollector::OFF; a named collector whose snapshot or socket is missing stops the start.
COLLECTOR = begin
  Busyyaks::AgentCollector.parse(YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml"))["agents"])
                          .tap { |c| Busyyaks::AgentCollector.check!(c) if c }
rescue Busyyaks::AgentCollector::Invalid => e
  abort "config/busyyaks.yml: #{e.message}"
end
CLAUDE_SESSIONS_DIR = ENV_FILE.fetch("CLAUDE_SESSIONS_DIR") { abort "CLAUDE_SESSIONS_DIR missing in .env" }
CLAUDE_SESSION_URL = ENV_FILE.fetch("CLAUDE_SESSION_URL") { abort "CLAUDE_SESSION_URL missing in .env" }
# The engines the collector may report (config/engines.yml + config/busyyaks.yml `engines:`), read once at start like the board
# config below: a bad table fails the launcher's start; a pane whose engine is not in it is shown, with the reason.
ENGINES = Busyyaks::Engines.load(YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml"))["engines"])
# config/harnesses.yml, read once at start (a bad file fails the start); the `harnesses` op looks each one up on THIS
# process's PATH (the systemd unit's) — the containers cannot see the host's programs
HARNESSES = begin
  Busyyaks::Harnesses.load
rescue Busyyaks::Harnesses::Invalid => e
  abort e.message
end
PANE_KEYS = %w[target cwd engine model context effort status waiting_for title status_at subagents_running unknown].freeze

# The host config FILE (config/kanban.yml): read ONCE, at start, beside the engine code it is parsed by — the checkout
# under ROOT changes under a running launcher (a merge, another session's branch), and a file re-read per launch
# against the engine loaded at start refused every spawn with "unknown keys session_dialogs" once the checkout gained
# a key the running engine did not know. New file or engine = restart the launcher (deploy/install-launcher.sh).
# Its launchers + agent types are NOT in it: each launch hands over the database revision it was planned
# from, and the engine config is rebuilt from FILE + that revision — refused unless every launcher's command is on
# COMMANDS, this host's allowlist (config/busyyaks.yml launch.commands, a host file: the containers mount it read-only,
# and no revision written from the dashboard can widen it).
BOARD_FILE = Busyyaks::AgentSettings.file_hash(File.join(ROOT, "config/kanban.yml")) # a broken file fails at start
COMMANDS = begin
  Busyyaks::AgentSettings.commands!(YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml")).dig("launch", "commands"))
rescue Busyyaks::AgentSettings::Error => e
  abort "config/busyyaks.yml: #{e.message}"
end

# The engine config a launch runs on: FILE + the revision the request carries, every command allowlisted.
def board_config(settings)
  doc = settings.is_a?(Hash) ? settings["doc"] : nil
  raise ArgumentError, "settings {id, doc} are required: the agent settings revision the launch was planned from" if doc.nil?

  Busyyaks::AgentSettings.allowed!(Busyyaks::AgentSettings.host(BOARD_FILE, doc), COMMANDS)
rescue AgentsKanban::ConfigError, AgentsKanban::Invalid, Busyyaks::AgentSettings::Error => e
  raise ArgumentError, "agent settings revision #{settings.is_a?(Hash) ? settings['id'] : '?'}: #{e.message}"
end

# The pane's process tree, read from /proc: does a `claude` in it run with --remote-control <name>?
def remote_control_running?(pane_pid, name)
  tree(pane_pid).any? do |pid|
    argv = (File.read("/proc/#{pid}/cmdline") rescue "").split("\0")
    next false unless File.basename(argv.first.to_s) == "claude" || argv.first.to_s.end_with?("/claude") || argv.include?("claude")

    # the LAST --remote-control is the effective one (a profile function may add an earlier one; Launch's wins)
    i = argv.rindex("--remote-control")
    i && argv[i + 1] == name
  end
end

# Claude Code's folder-trust prompt on a fresh session. Answering it lets the repo's .claude settings / hooks /
# .mcp.json run, so the launcher answers it only for a repo trusted from outside the repo (LaunchTrust: a
# launch.trusted_paths entry, or a repo this launcher's create made) — cursor to "Yes, I trust this folder" (checked
# on screen before Enter), then checks it is gone. Any other repo keeps the prompt on screen ({trust: "left"}): the
# launch flash says so, and a card the session owns gets it as a session dialog. Any OTHER dialog is never touched.
TRUST_YES = "Yes, I trust this folder"

def pane_text(name) = tmux("capture-pane", "-p", "-t", "=#{name}:").first.to_s

def trust_prompt?(text) = text.include?(TRUST_YES) && text.match?(/trust this folder|Do you trust/i)

# refusal: LaunchTrust.refusal, decided BEFORE the session started (a corrupt record refuses the launch, nothing runs).
# clock: the launch's one start clock (start_clock): the wait for the prompt (up to `wait`) ends at once when the start
# already failed — the command exited into a bare shell, launch.start_seconds passed, the session is gone — and
# answers nothing (the start check that follows reads the same clock and refuses with the true elapsed time). An agent
# that is up does NOT end it: claude runs (with its --remote-control) before it draws the trust prompt.
def accept_trust(name, refusal, clock, wait: 15)
  return { trust: "left", trust_reason: refusal } if refusal

  deadline = Busyyaks::Clock.now + wait
  until Busyyaks::Clock.now > deadline
    text = pane_text(name)
    break if trust_prompt?(text)
    return nil if text.match?(/bypass permissions on|for shortcuts|Try "/) # at its prompt already: nothing to answer
    return nil if start_probe(name, clock, "claude --remote-control #{name}", nil).is_a?(String)

    sleep 1
  end
  text = pane_text(name)
  return nil unless trust_prompt?(text)

  6.times do
    return accept_trust_enter(name) if text.lines.any? { |l| l.match?(/❯\s*(\d+\.\s*)?#{Regexp.escape(TRUST_YES)}/) }

    tmux("send-keys", "-t", "=#{name}:", "Down")
    sleep 0.3
    text = pane_text(name)
  end
  { trust: "failed", trust_reason: "could not select \"#{TRUST_YES}\" on the trust prompt" }
end

def accept_trust_enter(name)
  tmux("send-keys", "-t", "=#{name}:", "Enter")
  10.times do
    sleep 0.5
    return { trust: "accepted" } unless trust_prompt?(pane_text(name))
  end
  { trust: "failed", trust_reason: "the trust prompt is still on screen after Enter" }
end

# A dialog still on screen after start (not the trust prompt): the session is waiting for a person.
def dialog_on_screen(name)
  text = pane_text(name)
  return nil unless text.match?(/Enter to confirm|Esc to cancel|\(y\/n\)|Do you want to/i)

  text.lines.map(&:rstrip).reject(&:empty?).last(3).join(" · ")[0, 300]
end

# The pane's agent coming up after `tmux new-session` (both kinds): every second, `up` (pane_pid → true) is asked of the
# pane's process — the `bash -ic "<cmd>; exec bash"` — until it holds (→ nil), or the start failed (→ the reason, with
# the real elapsed seconds and the pane's last lines):
#   - the command exited: the pane's process has had NO child for BARE_CHECKS checks in a row — `<cmd>` is over and
#     `exec bash` left a bare shell (claude refused to start, the wrapper failed): refused at once;
#   - START_SECONDS passed while the command still runs (a wrapper still working, a claude that never took
#     --remote-control): refused;
#   - the tmux session is gone.
BARE_CHECKS = 3

# A launch's start clock, started at `tmux new-session`: the trust wait and the start check share it, so every
# refusal names the true elapsed seconds and launch.start_seconds bounds the whole start. Monotonic; the elapsed seconds
# and the refusal are LauncherRules.start_elapsed / start_overdue? (a start is refused only once start_seconds passed).
def start_clock = { started: Busyyaks::Clock.monotonic, bare: 0 }

# One look at the pane: :up (`up`, when given, holds for the pane's process), the failure reason, or nil (wait on)
def start_probe(name, clock, what, up)
  now = Busyyaks::Clock.monotonic
  elapsed = Busyyaks::LauncherRules.start_elapsed(clock[:started], now)
  out, _e, ok = tmux("list-panes", "-t", "=#{name}", "-F", "\#{pane_pid}")
  return "tmux session is gone after #{elapsed}s" unless ok

  pane_pid = out.lines.first.to_i
  return :up if up&.call(pane_pid)

  clock[:bare] = tree(pane_pid).size > 1 ? 0 : clock[:bare] + 1
  return "the command exited after #{elapsed}s, no #{what}: #{pane_tail(name)}" if clock[:bare] >= BARE_CHECKS
  if Busyyaks::LauncherRules.start_overdue?(clock[:started], now, START_SECONDS)
    return "no #{what} after #{elapsed}s (launch.start_seconds #{START_SECONDS}): #{pane_tail(name)}"
  end

  nil
end

def await_start(name, clock, what, up)
  loop do
    r = start_probe(name, clock, what, up)
    return nil if r == :up
    return r if r

    sleep 1
  end
end

def pane_tail(name)
  screen, _e, _ok = tmux("capture-pane", "-p", "-t", "=#{name}:")
  tail = screen.lines.map(&:rstrip).reject(&:empty?).last(4).join(" · ")[0, 400]
  tail.empty? ? "the pane is empty" : tail
end

# claude_code: `claude --remote-control <name>` in the pane's tree
def confirm_remote_control(name, clock)
  why = await_start(name, clock, "claude --remote-control #{name}", ->(pid) { remote_control_running?(pid, name) })
  why ? { remote_control: "failed", reason: why } : { remote_control: "on", remote_control_name: name }
end

def host_dir(container_path)
  Busyyaks::LauncherRules.host_dir(container_path, container_root: CONTAINER_ROOT, projects_root: PROJECTS_ROOT)
end

# tmux without $TMUX / $TMUX_PANE: a launcher started from inside a tmux pane (by hand, or a test) must never resolve a
# command's default target to the session it was started from (a tmux call with no -t once acted on that
# session). Every call names its target anyway.
TMUX_ENV = { "TMUX" => nil, "TMUX_PANE" => nil }.freeze

def tmux(*args)
  out, err, st = Open3.capture3(TMUX_ENV, "tmux", *args)
  [out, err, st.success?]
end

def sessions
  out, _err, ok = tmux("ls", "-F", "\#{session_name}\t\#{pane_current_path}\t\#{session_created}\t\#{session_attached}")
  return [] unless ok # no server = no sessions

  links = claude_links
  staged = staged_names
  # only the sessions named as busyyaks's (`by_…`): a session the operator started by hand never leaves this host
  out.lines.filter_map do |l|
    name, path, created, attached = l.chomp.split("\t")
    next unless Busyyaks::LauncherRules.busyyaks_session?(name)

    project_path = path == PROJECTS_ROOT || !path.start_with?("#{PROJECTS_ROOT}/") ? nil : path.sub(PROJECTS_ROOT, CONTAINER_ROOT)
    { name: name, path: path, project_path: project_path, created: created.to_i, attached: attached.to_i.positive?,
      claude_url: links[name], launched: staged.include?(name), }
  end
end

def session_name(base)
  base = base.to_s.gsub(/[^A-Za-z0-9_-]/, "_")
  # every tmux name, a hand-run one too: a new name never collides with any session on the server
  taken, why = live_session_names
  raise ArgumentError, "cannot name a session: #{why}" unless taken
  return base unless taken.include?(base)

  n = 1
  n += 1 while taken.include?("#{base}_#{n}")
  "#{base}_#{n}"
end

# config/harnesses.yml + every launch.commands command, resolved in the shell a launch runs in (bash -ic)
# and each harness program's version read — read-only, no parameter: the web never names a command to run here.
def harnesses_op
  probe = Busyyaks::Harnesses.probe(HARNESSES, COMMANDS.map { |c| c["command"] },
                                    env: { "PATH" => ENV.fetch("PATH"), "HOME" => ENV.fetch("HOME") },
                                    run: method(:harness_run))
  catalogue = HARNESSES.to_h { |h| [h.key, h.to_h] }
  # allowlist: the launch.commands THIS launcher enforces (read at its start): the web compares it with its own read
  { ok: true, shell: "bash -ic", harnesses: probe[:harnesses].map { |r| catalogue.fetch(r[:key]).merge(r) },
    commands: probe[:commands], allowlist: COMMANDS, }
rescue Busyyaks::Harnesses::Failed => e
  { ok: false, error: e.message, status: 500 }
end

# The probe's children (Busyyaks::Harnesses.probe's runner; the services never spawn): its own process group, no
# stdin, output read as it runs (the first Harnesses::OUTPUT_MAX bytes kept), killed with its group at the deadline
# (read through the Clock). clean_env: only `env` (the version runs); else `env` over this process's (the launch shell).
# → [output, 0 | the exit code | "signal N", or nil when killed at the deadline]
def harness_run(env, argv, timeout_s:, err:, clean_env:)
  max = Busyyaks::Harnesses::OUTPUT_MAX
  r, w = IO.pipe
  pid = Process.spawn(env, *argv, in: File::NULL, out: w, err: err == :out ? w : File::NULL, pgroup: true,
                                  unsetenv_others: clean_env)
  w.close
  out = +""
  deadline = Busyyaks::Clock.monotonic + timeout_s
  loop do
    chunk = r.read_nonblock(max, exception: false)
    out << chunk if chunk.is_a?(String) && out.bytesize < max
    _, status = Process.wait2(pid, Process::WNOHANG)
    if status
      rest = r.read_nonblock(max, exception: false)
      out << rest if rest.is_a?(String) && out.bytesize < max
      code = status.exitstatus || "signal #{status.termsig}"
      return [out.byteslice(0, max).scrub, code]
    end
    if Busyyaks::Clock.monotonic >= deadline
      begin
        Process.kill("KILL", -pid)
      rescue Errno::ESRCH
        nil # it ended between the look and the kill
      end
      Process.wait(pid)
      return [out.byteslice(0, max).scrub, nil]
    end
    # wait for output or the child's end, never spin on a child that writes without pause (the deadline still bounds it)
    r.wait_readable(0.02) unless chunk.nil?
    Busyyaks::Clock.pause(0.02) if chunk.nil? # EOF: the child closed its output; its exit is near
  end
ensure
  w.close if w && !w.closed? # a spawn that raised never handed the write end to a child
  r&.close
end

# A free tmux session name for a board (the engine registers it, then asks for the launch under that name).
def name_op(req)
  base = req["base"].to_s
  raise ArgumentError, "base is required (the engine's agent_types[].session_name, rendered)" if base.empty?
  unless Busyyaks::LauncherRules.busyyaks_session?(base)
    raise ArgumentError, "session name #{base.inspect} must start with #{Busyyaks::LauncherRules::SESSION_PREFIX.inspect}: " \
                         "every session busyyaks starts is named so (agent settings session_name)"
  end

  { ok: true, session: session_name(base) }
end

# The pane's process tree, read from /proc: does a process in it run `command` (its argv's program or script)?
def command_running?(pane_pid, command)
  tree(pane_pid).any? do |pid|
    argv = (File.read("/proc/#{pid}/cmdline") rescue "").split("\0")
    # a program, the script an interpreter runs (python <path>/hermes), or a process that names itself (hermes's
    # installer launcher: `python -I -c <bootstrap>`, comm hermes)
    argv.first(2).any? { |a| File.basename(a) == command } || (File.read("/proc/#{pid}/comm").strip rescue "") == command
  end
end

# claude_code: the `claude` running with --remote-control <name> carries --mcp-config <stage>/mcp.json (the board's
# MCP, MCP_BOARD_TOKEN) → nil, else why
def claude_board_on(name, stage)
  want = Busyyaks::BoardMcp.claude_path(stage)
  pane_pid = tmux("list-panes", "-t", "=#{name}", "-F", "\#{pane_pid}")[0].lines.first.to_i
  on = tree(pane_pid).any? do |pid|
    argv = (File.read("/proc/#{pid}/cmdline") rescue "").split("\0")
    i = argv.rindex("--remote-control")
    i && argv[i + 1] == name && argv.each_cons(2).any? { |a, b| a == "--mcp-config" && b == want }
  end
  on ? nil : "the agent runs without the board's MCP: no --mcp-config #{want} on its claude (its launcher command drops busyyaks's flags)"
end

# claude_code: the `claude` running with --remote-control <name> carries --plugin-dir <stage> (the session's skills)
# → nil, else why
def claude_skills_on(name, stage)
  pane_pid = tmux("list-panes", "-t", "=#{name}", "-F", "\#{pane_pid}")[0].lines.first.to_i
  on = tree(pane_pid).any? do |pid|
    argv = (File.read("/proc/#{pid}/cmdline") rescue "").split("\0")
    i = argv.rindex("--remote-control")
    next false unless i && argv[i + 1] == name

    argv.each_cons(2).any? { |a, b| a == "--plugin-dir" && b == stage }
  end
  on ? nil : "the agent runs without its skills: no --plugin-dir #{stage} on its claude (its launcher command drops busyyaks's flags)"
end

# hermes: asks the ALLOWLISTED command (hermes_ask), with this launch's environment, whether the entry skill is listed
# (`hermes skills list`); the running process is only read, to check it has that same environment.
HERMES_PROBE_SECONDS = 60
HERMES_TABLE_COLUMNS = "400"

# The session's Hermes as DATA: [pid, its environment]. Nothing read here is ever executed.
def hermes_session(name, command)
  pane_pid = tmux("list-panes", "-t", "=#{name}", "-F", "\#{pane_pid}")[0].lines.first.to_i
  pid = tree(pane_pid).find do |p|
    argv = (File.read("/proc/#{p}/cmdline") rescue "").split("\0")
    argv.first(2).any? { |a| File.basename(a) == command } || (File.read("/proc/#{p}/comm").strip rescue "") == command
  end
  pid && [pid, (File.read("/proc/#{pid}/environ") rescue "").split("\0").to_h { |kv| kv.split("=", 2) }]
end

# Asks Hermes through the ALLOWLISTED command (launch.commands), resolved by the launch shell as the session's was, with
# the environment this launch gave it. Never a program, argv or environment taken from a pane's process.
def hermes_ask(launcher, stage, delivery, *args)
  env = ENV.to_h.merge(delivery.env(stage), Busyyaks::HermesBoard.env(File.join(stage, Busyyaks::HermesBoard::DIR)),
                       "COLUMNS" => HERMES_TABLE_COLUMNS) # its tables are cut to the terminal's width
  Open3.capture3(env, "timeout", HERMES_PROBE_SECONDS.to_s, "bash", "-ic",
                 Shellwords.join([launcher.command, *args]), chdir: "/", in: File::NULL)
end

# The running process has THIS launch's environment (read as data) → nil, else why
def hermes_env_refusal(env, delivery, stage)
  want = delivery.env(stage).merge(Busyyaks::HermesBoard.env(File.join(stage, Busyyaks::HermesBoard::DIR)))
  key = want.keys.find { |k| env[k] != want[k] }
  key && "its process does not run with this launch's #{key}"
end

def hermes_skills_on(name, launcher, stage, delivery)
  _pid, env = hermes_session(name, launcher.command)
  return "no #{launcher.command} process in the pane to ask for its skills" unless env

  why = hermes_env_refusal(env, delivery, stage)
  return "the agent runs without its skills: #{why}" if why

  out, err, st = hermes_ask(launcher, stage, delivery, "skills", "list")
  return "hermes skills list failed (exit #{st.exitstatus}): #{err.strip[0, 300]}" unless st.success?

  home = env["HERMES_HOME"].to_s.empty? ? File.join(env.fetch("HOME", "~"), ".hermes") : env["HERMES_HOME"]
  why = delivery.listed(out, home)
  why && "the agent runs without its skills: #{why}"
end

# Is this session a board agent (HermesBoard)? Asked of the allowlisted Hermes with this launch's environment; the
# process is checked to run with that same environment and home. Its user config is read, never written. Proven →
# recorded (pid + start time), so pings may be typed into this process. → nil, else why
def hermes_board_on(name, launcher, stage, delivery)
  pid, env = hermes_session(name, launcher.command)
  return "no #{launcher.command} process in the pane to ask for its board settings" unless pid

  why = hermes_env_refusal(env, delivery, stage)
  return "not a board session: #{why}" if why

  out, err, st = hermes_ask(launcher, stage, delivery, "config", "path")
  return "hermes config path failed (exit #{st.exitstatus}): #{err.strip[0, 300]}" unless st.success?

  path = out.lines.last.to_s.strip
  home = env["HERMES_HOME"].to_s
  return "not a board session: its process uses #{home}, the check read #{path}" \
    unless home.empty? || File.dirname(path) == home

  url = Busyyaks::HermesBoard.mcp!(ENV_FILE)[:url]
  get = lambda do |key|
    o, _e, s = hermes_ask(launcher, stage, delivery, "config", "get", key)
    s.success? ? o.lines.last.to_s.strip : nil
  end
  why = Busyyaks::HermesBoard.refusal(path: path, user_config: (File.read(path) rescue nil), url: url, get: get)
  return "not a board session: #{why}" if why

  ticks = proc_start_ticks(pid) or return "its process #{pid} ended during the start check"
  HERMES_BOARD.record(session: name, pid: pid, start_ticks: ticks, alive: ->(s) { tmux("has-session", "-t", "=#{s}")[2] })
  nil
end

def proc_start_ticks(pid)
  Integer(File.read("/proc/#{pid}/stat").sub(/\A.*\) /m, "").split[19], 10)
rescue SystemCallError, ArgumentError, TypeError
  nil
end

# tmux's session names → [names, nil]; [[], nil] when no server runs; [nil, why] when tmux cannot be read
def live_session_names
  out, err, ok = tmux("ls", "-F", "\#{session_name}")
  return [out.lines.map(&:chomp), nil] if ok
  # no server (measured, tmux 3.x): "no server running on <socket>", or the socket missing — "error connecting to
  # <socket> (No such file or directory)". Anything else (Permission denied, …) is an error, never "no sessions"
  return [[], nil] if err.match?(/no server running on |error connecting to .* \(No such file or directory\)/)

  [nil, "tmux ls failed: #{err.strip.empty? ? 'no output' : err.strip[0, 200]}"]
end

# Removes the stages of sessions tmux no longer lists — at launcher start, before each launch's stage and
# on every `sessions` op (the notifier's watch pass asks it, so a stage goes within a pass of its session's end).
# tmux unreadable → nothing removed, said in the log (never read as "no sessions"). Call under STAGE_LOCK.
# The sessions busyyaks runs (2026-11-24, the operator: "It must not appear in working agents if it's not run by
# busyyaks"): a launch stages the session's skills under STAGES/<session> before tmux starts it, and the stage sweep
# removes the stage once the session is gone — a session started by hand never has one. No STAGES dir = nothing
# launched yet.
# Proof that busyyaks started a session (2026-11-24, R3): its name carries the `by_` prefix, it has a stage, and the
# stage's launched.json records the pane's pid and that process's start time, written by the launch that started it.
# A session started by hand — even one named or renamed `by_…` — has no such record, or a pane that is not the recorded
# process: it is never listed, stopped, typed into, answered, attached to or read.
LAUNCHED_FILE = "launched.json"

# {session name => its first pane's pid}, one tmux call; nil when tmux cannot be read (never "no sessions": the same
# rule as live_session_names — a real "no server" answer is {})
def pane_pids
  out, err, ok = tmux("list-panes", "-a", "-F", "\#{session_name}\t\#{pane_pid}")
  unless ok
    return {} if err.match?(/no server running on |error connecting to .* \(No such file or directory\)/)

    return nil
  end

  out.lines.each_with_object({}) do |l, h|
    name, pid = l.chomp.split("\t")
    h[name] ||= pid.to_i
  end
end

def record_launched(name, stage)
  pid = pane_pids&.[](name)
  ticks = pid&.positive? ? proc_start_ticks(pid) : nil
  return "its pane is unreadable (no pid / start time): not recorded as busyyaks's" unless ticks

  File.open(File.join(stage, LAUNCHED_FILE), File::WRONLY | File::CREAT | File::EXCL, 0o600) do |f|
    f.write(JSON.generate({ "pane_pid" => pid, "start_ticks" => ticks }))
  end
  nil
end

# sock: busyyaks starts its sessions on the default tmux server only — a session on any other socket is never its own
def launched?(name, pids = pane_pids, sock = "default")
  return false unless sock.to_s == "default" && pids && Busyyaks::LauncherRules.busyyaks_session?(name)

  rec = JSON.parse(File.read(File.join(STAGES, name, LAUNCHED_FILE)))
  pid = pids[name]
  !pid.nil? && pid == rec["pane_pid"] && proc_start_ticks(pid) == rec["start_ticks"]
rescue SystemCallError, JSON::ParserError, TypeError
  false
end

def staged_names
  return [] unless File.directory?(STAGES)

  pids = pane_pids or return []
  Dir.children(STAGES).select { |n| launched?(n, pids) }
end

# The `agents` op: the collector's snapshot cut to the sessions busyyaks launched (staged_names) — the sidebar, the
# project lanes, the live line, the board glow and Clear idle never show or touch a session started by hand.
def launched_agents
  snap = agents
  return snap unless snap[:ok]

  staged = staged_names
  snap.merge(sessions: snap[:sessions].select { |s| s["socket"] == "default" && staged.include?(s["name"]) })
end

def sweep_stages(where)
  live, why = live_session_names
  return puts("#{Busyyaks::Clock.now.iso8601} skills sweep skipped (#{where}): #{why}") unless live

  gone = Busyyaks::Skills.sweep(STAGES, live + IN_FLIGHT)
  puts "#{Busyyaks::Clock.now.iso8601} skills sweep (#{where}): removed #{gone.join(', ')}" if gone.any?
  sweep_scopes(where, live + IN_FLIGHT)
end

# Stops the systemd user scope of every session that ended (LauncherRules.stale_scopes): what it left running in
# the background dies with it, and its name is free for the next launch. launch.scopes null → no scopes to sweep.
# systemctl unreadable → nothing stopped, said in the log. Each stop is logged with the processes it ended.
def sweep_scopes(where, live)
  return if SCOPES.nil?

  out, err, st = Open3.capture3("systemctl", "--user", "list-units", "--type=scope", "--all", "--plain", "--no-legend",
                                "--no-pager", "#{Busyyaks::LauncherRules::SCOPE_PREFIX}*", in: File::NULL)
  unless st.success?
    return puts("#{Busyyaks::Clock.now.iso8601} scope sweep skipped (#{where}): systemctl: #{err.strip[0, 200]}")
  end

  Busyyaks::LauncherRules.stale_scopes(out, live).each do |unit|
    procs = scope_procs(unit)
    _o, serr, sst = Open3.capture3("systemctl", "--user", "stop", unit, in: File::NULL)
    verdict = sst.success? ? "stopped" : "stop FAILED: #{serr.strip[0, 200]}"
    puts "#{Busyyaks::Clock.now.iso8601} scope sweep (#{where}): #{unit} #{verdict} · " \
         "#{procs.empty? ? 'no processes' : procs.join(' | ')}"
  end
end

def scope_procs(unit)
  cg, _e, st = Open3.capture3("systemctl", "--user", "show", "-p", "ControlGroup", "--value", unit, in: File::NULL)
  return [] unless st.success? && !cg.strip.empty?

  File.read(File.join("/sys/fs/cgroup", cg.strip, "cgroup.procs")).split.map do |pid|
    cmd = File.read("/proc/#{pid}/cmdline").tr("\0", " ").strip
    "#{pid} #{cmd[0, 120]}"
  rescue SystemCallError
    pid
  end
rescue SystemCallError
  []
end

def tree(root)
  kids = Hash.new { |h, k| h[k] = [] }
  Dir.glob("/proc/[0-9]*/stat").each do |f|
    st = File.read(f) rescue next
    kids[st.sub(/\A.*\) /m, "").split[1].to_i] << f[%r{/proc/(\d+)/}, 1].to_i
  end
  out = []
  todo = [root]
  until todo.empty?
    pid = todo.shift
    out << pid
    todo.concat(kids[pid])
  end
  out
end

# A kind with no remote control (hermes): its command running in the pane's tree
def confirm_process(name, command, clock)
  why = await_start(name, clock, "#{command} process", ->(pid) { command_running?(pid, command) })
  why ? { process: "failed", reason: why } : { process: "on", process_name: command }
end

# What this host checks after a start, per launcher KIND (the engine's Launch::KINDS; a kind missing here refuses the
# launch): claude_code = Claude Code's folder-trust prompt answered (LaunchTrust) + `claude --remote-control <name>`
# up; hermes = no trust prompt, no remote control: its command running in the pane. skills_why = nil when the started
# agent has the session's staged skills, else why: claude_code --plugin-dir <stage> on its argv; hermes
# lists busyyaks-session when the allowlisted command is asked with this launch's environment.
HOST_KINDS = {
  "claude_code" => { trust: true, up: ->(name, _launcher, clock) { confirm_remote_control(name, clock) },
                     up?: ->(r) { r[:remote_control] == "on" },
                     skills_why: ->(name, _launcher, stage, _delivery) { claude_skills_on(name, stage) },
                     # the board MCP (MCP_BOARD_TOKEN) for this session only: <stage>/mcp.json, --mcp-config
                     stage_env: lambda { |stage|
                       Busyyaks::BoardMcp.claude!(stage, Busyyaks::BoardMcp.endpoint!(ENV_FILE))
                       {}
                     },
                     board_why: ->(name, _launcher, stage, _delivery) { claude_board_on(name, stage) }, },
  "hermes" => { trust: false, up: ->(name, launcher, clock) { confirm_process(name, launcher.command, clock) },
                up?: ->(r) { r[:process] == "on" },
                skills_why: ->(name, launcher, stage, delivery) { hermes_skills_on(name, launcher, stage, delivery) },
                # the per-launch overlay (queue mode + the busyyaks MCP), proven after the start
                stage_env: lambda { |stage|
                  Busyyaks::HermesBoard.env(Busyyaks::HermesBoard.stage!(stage, Busyyaks::HermesBoard.mcp!(ENV_FILE)))
                },
                board_why: ->(name, launcher, stage, delivery) { hermes_board_on(name, launcher, stage, delivery) }, },
}.freeze

# The start of a session the engine already registered (Api#launch → this): the type's argv from the board config
# (the prompt — the type's template rendered with the engine's values + {dir}, which only this side knows — passed
# the way the launcher's kind takes it: claude_code positional with `--remote-control <session>` still LAST, hermes
# `-q`), in a detached tmux session named as the engine said.
def launch(req)
  cfg = board_config(req["settings"])
  dir = host_dir(req["path"])
  name = req["session"].to_s
  raise ArgumentError, "session must match the tmux name alphabet" unless name.match?(AgentsKanban::Launch::SESSION)
  busyyaks_name!(name)
  _o, _e, exists = tmux("has-session", "-t", "=#{name}")
  raise ArgumentError, "tmux session #{name} already exists" if exists

  vars = Busyyaks::LauncherRules.launch_vars(req["vars"], dir: dir) # the engine's keys; {dir} is ours
  begin
    t = cfg.agent_type(req["type"])
    launcher = cfg.launcher(t.launcher!(req["launcher"]))
    host_kind = HOST_KINDS.fetch(launcher.kind) do
      raise ArgumentError, "launcher #{launcher.key}: kind #{launcher.kind} has no start check on this host (#{HOST_KINDS.keys.join(', ')})"
    end
  rescue AgentsKanban::Invalid => e
    raise ArgumentError, e.message
  end
  # lead-first: refused here, before anything is staged or started
  lead_key = lead_first!(cfg, t, req, dir)
  # the folder-trust decision first: a record it cannot read refuses the launch before anything starts. It also decides
  # whether the repo's own skills load (Skills.plan!: an untrusted repo gets busyyaks's skills, "left: <why>")
  refusal = begin
    Busyyaks::LaunchTrust.refusal(dir, trusted: TRUSTED, created: CREATED)
  rescue Busyyaks::LaunchTrust::Invalid => e
    raise ArgumentError, "folder trust: #{e.message}"
  end
  # the session's skills: selected, validated, staged as a copy — any failure refuses the launch, nothing started
  stage = File.join(STAGES, name)
  delivery, receipt, project_skills = begin
    d = Busyyaks::Skills.delivery(launcher.kind)
    selected, ps = Busyyaks::Skills.plan!(checkout: ROOT, repo: dir, type: t.key, types: cfg.agent_type_keys,
                                          settings: SKILLS, trust_refusal: refusal)
    STAGE_LOCK.synchronize do
      raise ArgumentError, "a launch of #{name} is already in flight" if IN_FLIGHT.include?(name)

      sweep_stages("launch #{name}")
      IN_FLIGHT << name
    end
    [d, Busyyaks::Skills.stage!(selected, stage, d), ps]
  rescue Busyyaks::Skills::Invalid, SystemCallError => e
    STAGE_LOCK.synchronize { IN_FLIGHT.delete(name) }
    FileUtils.rm_rf(stage)
    raise ArgumentError, "skills: #{e.message}"
  end
  begin
    launch_staged(StagedLaunch.new(cfg, dir, name, vars, t, launcher, host_kind, refusal, stage, delivery, receipt,
                                   project_skills, lead_key))
  ensure
    STAGE_LOCK.synchronize { IN_FLIGHT.delete(name) }
  end
end

# The rest of a launch once its skills are staged (IN_FLIGHT holds its name until it returns)
StagedLaunch = Struct.new(:cfg, :dir, :name, :vars, :type, :launcher, :host_kind, :refusal, :stage, :delivery, :receipt,
                          :project_skills, :lead_key)

def launch_staged(job)
  cfg, dir, name, vars, t, launcher, host_kind, refusal, stage, delivery, receipt, project_skills, lead_key = job.to_a
  begin
    prompt = delivery.prompt(t.prompt && AgentsKanban::Launch.render(t.prompt, **vars))
    argv = AgentsKanban::Launch.argv(cfg, type: t.key, launcher: launcher.key, session: name, prompt: prompt,
                                          extra: delivery.extra(stage))
    kind_env = host_kind[:stage_env].call(stage)
  rescue AgentsKanban::Invalid, Busyyaks::HermesBoard::Invalid, Busyyaks::BoardMcp::Invalid, SystemCallError => e
    FileUtils.rm_rf(stage)
    raise ArgumentError, e.message
  end
  argv = Busyyaks::LauncherRules.scoped(argv, scopes: SCOPES, session: name, lead: cfg.lead_type?(t))
  cmd = Shellwords.join(argv)
  # `bash -ic` so ~/.bashrc functions (fullclaude, …) exist; `exec bash` keeps the pane open after claude exits.
  env = delivery.env(stage).merge(kind_env).flat_map { |k, v| ["-e", "#{k}=#{v}"] }
  _out, err, ok = tmux("new-session", "-d", "-s", name, "-c", dir, *env, "bash", "-ic", "#{cmd}; exec bash")
  unless ok
    FileUtils.rm_rf(stage)
    raise "tmux failed: #{err.strip}"
  end

  clock = start_clock
  trust = host_kind[:trust] ? accept_trust(name, refusal, clock) || {} : {}
  rc = host_kind[:up].call(name, launcher, clock)
  up = host_kind[:up?].call(rc)
  # a dialog on a claude that is up (its permission / question prompt): a live session — kept (below), the dialog
  # reported to the operator as the result's verdict + reason (information only: it never decides the keep)
  waiting = up ? dialog_on_screen(name) : nil
  rc = rc.merge(remote_control: "failed", reason: "waiting on a dialog: #{waiting}") if waiting && rc[:remote_control] == "on"
  # a lead that came up: its key into LEADS (the launcher's state only) BEFORE the checks below, which take
  # seconds on Hermes while its first turn already runs and may spawn. A start they refuse kills the session,
  # and a key is only ever answered while its session runs.
  alive = ->(s) { tmux("has-session", "-t", "=#{s}")[2] }
  LEADS.record(session: name, type: t.key, dir: dir, key: lead_key, alive: alive) if lead_key && up
  # an agent that is up without the stage (a shell function that drops the extra flags, an env reset): refused loudly
  if up && (why = host_kind[:skills_why].call(name, launcher, stage, delivery))
    up = false
    rc = rc.merge(reason: why)
  end
  if up && (why = host_kind[:board_why].call(name, launcher, stage, delivery))
    up = false
    rc = rc.merge(reason: why)
  end
  # the proof that busyyaks started it (launched?): its pane's pid + start time, recorded in its own stage
  if up && (why = record_launched(name, stage))
    up = false
    rc = rc.merge(reason: why)
  end
  skills = receipt.map { |r| "#{r[:name]}(#{r[:source]},#{r[:load]},#{r[:sha][0, 12]})" }.join(" ")
  puts "#{Busyyaks::Clock.now.iso8601} launched #{name} (#{t.key}/#{launcher.key}, #{launcher.kind}) in #{dir} · trust #{trust[:trust] || 'not asked'} · skills #{skills} · project_skills #{project_skills} · #{rc.except(:reason).map { |k, v| "#{k} #{v}" }.join(' · ')}#{rc[:reason] ? " (#{rc[:reason]})" : ''}"
  # the kind's start check failed (claude: no `claude --remote-control <name>` came up — it refused to start, exited,
  # the pane is a bare shell; hermes: no hermes process): the launch FAILED — the session is killed and refused, so
  # the engine ends the registration and releases what it adopted (never a registered owner nobody runs). Only a
  # running agent is kept: a pane that merely LOOKS like a dialog with no agent process is a failed start.
  unless up
    _o, kerr, killed = tmux("kill-session", "-t", "=#{name}")
    gone = killed || !tmux("has-session", "-t", "=#{name}")[2]
    error = "#{name} did not start: #{rc[:reason]}"
    error += " — and kill-session failed (#{kerr.strip}): the tmux session #{name} is still running" unless gone
    FileUtils.rm_rf(stage) if gone
    return { ok: false, error: error, status: 422 }
  end
  { ok: true, session: name, type: t.key, launcher: launcher.key, kind: launcher.kind, dir: dir, prompt: !prompt.nil?,
    skills: receipt, project_skills: project_skills, **trust, **rc }
end

# LEAD-FIRST BOARDS, checked here too — the engine's registration is not trusted past this socket:
#   a lead type brings its key (lead_key, 64 hex): kept in LEADS (this launcher's state dir) once its start is up —
#   never put into the tmux session, logged or answered (only the lead_key op gives it back);
#   a type `under` a lead starts only under a lead THIS launcher started for the SAME repo dir, of the type it runs
#   under, whose tmux session runs (req "lead"), and brings no key; any other type brings neither.
# → the lead's key to record after the start (nil for any other type). Refused (ArgumentError): nothing starts.
def lead_first!(cfg, type, req, dir)
  key = req["lead_key"]
  lead = req["lead"]
  if type.under
    raise ArgumentError, "a #{type.key} session runs under the board's #{type.under}: no lead session given" \
      unless lead.is_a?(String) && lead.match?(AgentsKanban::Launch::SESSION)

    begin
      LEADS.under!(lead, lead_type: type.under, dir: dir, alive: ->(s) { tmux("has-session", "-t", "=#{s}")[2] })
    rescue Busyyaks::LauncherRules::Invalid => e
      raise ArgumentError, e.message
    end
  elsif !lead.nil?
    raise ArgumentError, "a #{type.key} session runs under no lead (got lead #{lead.inspect})"
  end
  unless cfg.lead_type?(type)
    raise ArgumentError, "a #{type.key} session gets no lead key" unless key.nil?

    return nil
  end
  raise ArgumentError, "a #{type.key} session needs its lead key (64 hex)" \
    unless key.is_a?(String) && key.match?(Busyyaks::LauncherRules::Leads::KEY)

  key
end

# {"op":"lead_key","session"} → {ok, key}: the key of a lead this launcher started, while its tmux session runs
# (the engine's kanban_spawn / kanban_register lead check compares its digest). Refused for any other session.
def lead_key_op(req)
  name = req["session"].to_s
  e = LEADS.find(name)
  return { ok: false, error: "#{name}: no lead this launcher started", status: 422 } unless e
  return { ok: false, error: "#{name}: its tmux session is not running", status: 422 } \
    unless tmux("has-session", "-t", "=#{name}")[2]

  { ok: true, key: e["key"] }
end

NAME = /\A[A-Za-z0-9][A-Za-z0-9._-]{0,99}\z/
JOBS = [] # clone jobs, newest last; kept in memory for the page's status list
JOBS_LOCK = Mutex.new

def roots
  YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml")).fetch("roots").map { |r| r.fetch("path") }
end

# New repo in a configured root: empty dir + `git init -b main`, or a background `git clone`.
def create(req)
  root = req["root"].to_s
  raise ArgumentError, "unknown root #{root.inspect}" unless roots.include?(root)

  url = req["url"].to_s.strip
  # parsed strictly (LaunchTrust.clone_url!): git gets only the URL rebuilt from host / owner / repo
  parsed = begin
    url.empty? ? nil : Busyyaks::LaunchTrust.clone_url!(url)
  rescue Busyyaks::LaunchTrust::Invalid => e
    raise ArgumentError, e.message
  end

  name = req["name"].to_s.strip
  name = parsed[:repo] if name.empty? && parsed
  raise ArgumentError, "name must match #{NAME.source}" unless name.match?(NAME)

  parent = root == CONTAINER_ROOT ? PROJECTS_ROOT : File.join(PROJECTS_ROOT, root.delete_prefix("#{CONTAINER_ROOT}/"))
  raise ArgumentError, "root not on disk: #{parent}" unless File.directory?(parent)

  dir = File.join(parent, name)
  # both paths start by reserving the dir: an exclusive mkdir — a second create of the name (a clone racing an init,
  # two inits) gets EEXIST and is refused with nothing written
  begin
    Dir.mkdir(dir)
  rescue Errno::EEXIST
    raise ArgumentError, "already exists: #{dir}"
  end

  return clone(parsed, dir, File.join(root, name)) if parsed

  # git init only in the dir this call just made; recorded only while it holds nothing but that fresh .git
  _o, err, st = Open3.capture3("git", "init", "-q", "-b", "main", dir, in: File::NULL)
  raise "git init failed: #{err.strip}" unless st.success?

  trusted, trust_error = record_created(dir)
  puts "#{Busyyaks::Clock.now.iso8601} created #{dir}"
  { ok: true, path: File.join(root, name), cloning: false, trusted: trusted, trust_error: trust_error }
end

# [true, nil] = recorded (trusted) — git init only; [false, why] = not recorded (a record that cannot be written, or
# a repo that is no longer just a fresh init): untrusted, said in the log and in create's answer
def record_created(dir)
  CREATED.record(dir)
  [true, nil]
rescue StandardError => e
  puts "#{Busyyaks::Clock.now.iso8601} git init #{dir}: NOT recorded as created (#{e.class}: #{e.message}); its trust prompt is left"
  [false, "#{e.class}: #{e.message}"]
end

# A clone is never trusted (what a URL serves is whoever owns it — a fork under your own name included): it keeps the
# trust prompt for the operator. It runs with nothing inherited (LaunchTrust.clone_env, unsetenv_others).
def clone(parsed, dir, container_path)
  url = parsed[:url]
  log = File.join(RUN_DIR, "clone-#{File.basename(dir)}-#{Busyyaks::Clock.epoch}.log")
  job = { url: url, path: container_path, log: File.basename(log), started: Busyyaks::Clock.epoch, status: "running", exit: nil }
  JOBS_LOCK.synchronize { JOBS << job; JOBS.shift while JOBS.size > 20 }
  home = Dir.mktmpdir("busyyaks-clone-home") # empty: no gitconfig but the command line's
  template = Dir.mktmpdir("busyyaks-clone-template") # empty: no hooks or config copied into the new .git
  pid = Process.spawn(Busyyaks::LaunchTrust.clone_env(home, template), *Busyyaks::LaunchTrust.clone_argv(url, dir),
                      %i[out err] => [log, "w"], in: File::NULL, unsetenv_others: true)
  Thread.new do
    _, st = Process.wait2(pid)
    FileUtils.rm_rf([home, template])
    JOBS_LOCK.synchronize { job[:status] = st.success? ? "done" : "failed"; job[:exit] = st.exitstatus }
    puts "#{Busyyaks::Clock.now.iso8601} clone #{url} → #{dir}: exit #{st.exitstatus}"
  end
  puts "#{Busyyaks::Clock.now.iso8601} cloning #{url} → #{dir}"
  { ok: true, path: container_path, cloning: true, trusted: false }
end

def jobs
  JOBS_LOCK.synchronize do
    JOBS.map do |j|
      tail = File.readlines(File.join(RUN_DIR, j[:log])).last(3).map { |l| l.split("\r").last.to_s.strip }.reject(&:empty?)
      j.merge(tail: tail)
    rescue Errno::ENOENT
      j.merge(tail: [])
    end
  end
end

# tmux session name → its Claude Remote Control page, from Claude Code's live session records
# (<pid>.json: "tmux":"name:@w.%p", "bridgeSessionId"). Only records whose process is alive; a session
# without a bridge id (no --remote-control, Hermes) gets no link.
def claude_links
  Dir.glob(File.join(CLAUDE_SESSIONS_DIR, "*.json")).each_with_object({}) do |f, acc|
    rec = JSON.parse(File.read(f)) rescue next
    pid = rec["pid"].to_i
    bridge = rec["bridgeSessionId"].to_s
    name = rec["tmux"].to_s.split(":").first
    next if pid <= 0 || bridge.empty? || name.to_s.empty? || !File.exist?("/proc/#{pid}")
    next unless bridge.match?(/\A[A-Za-z0-9_-]{8,80}\z/)

    acc[name] = CLAUDE_SESSION_URL.gsub("{id}", bridge)
  end
end

# The agent_engines collector's snapshot, reduced to allowlisted fields. A stale or unreadable snapshot is
# said (stale_s / error), never papered over: the sidebar shows it.
def agents
  raw = File.read(COLLECTOR.snapshot)
  snap = JSON.parse(raw)
  links = claude_links
  age = Busyyaks::Clock.now.to_f - snap.fetch("generated_at").to_f
  sessions = snap.fetch("sessions").map do |s|
    panes = s.fetch("panes").map do |p|
      pane = p.slice(*PANE_KEYS)
      cwd = p["cwd"].to_s
      pane["project_path"] = cwd.start_with?("#{PROJECTS_ROOT}/") ? cwd.sub(PROJECTS_ROOT, CONTAINER_ROOT) : nil
      eng = ENGINES.pane(p["engine"])
      pane["engine_label"] = eng[:label] if eng[:label]
      pane["screen"] = eng[:error] ? { error: eng[:error] } : pane_screen(s["socket"], p["pane_id"], eng[:family])
      pane
    end
    s.slice("name", "socket", "attached", "created", "activity", "windows").merge("panes" => panes, "claude_url" => links[s["name"]])
  end
  { ok: true, generated_at: snap["generated_at"], age_s: age.round(1), interval_s: snap["interval_s"],
    collector_error: snap["error"], sessions: sessions }
rescue Errno::ENOENT, Errno::EACCES, JSON::ParserError, KeyError => e
  { ok: false, error: "agents snapshot unreadable (#{COLLECTOR.snapshot}): #{e.class}: #{e.message}", status: 503 }
end

# What the pane draws now, read by herdr's rules (Busyyaks::AgentScreen): {state, rule} — plus, when working, what it
# does (Busyyaks::AgentActivity: thinking / tool / writing, nil when the screen does not say), and, when blocked on a
# Claude Code dialog, the dialog (question, command, options, hash: what the sidebar shows and answers). Only the
# verdict leaves the host, never the screen. A pane tmux cannot read → {error} (shown), never a guessed state.
def pane_screen(socket, pane_id, family)
  sock = socket.to_s
  return { error: "bad pane #{pane_id.inspect}" } unless pane_id.to_s.match?(/\A%\d+\z/) && sock.match?(/\A[\w.-]{1,64}\z/)

  base = sock == "default" ? [] : ["-L", sock]
  text, err, ok = tmux(*base, "capture-pane", "-p", "-t", pane_id)
  return { error: "capture-pane #{pane_id}: #{err.strip}" } unless ok

  title, = tmux(*base, "display-message", "-p", "-t", pane_id, "\#{pane_title}")
  verdict = Busyyaks::AgentScreen.detect(family.rules, text, title.to_s.chomp)
  verdict[:activity] = settled_activity("#{sock}/#{pane_id}", family.activity(text)) if verdict[:state] == "working"
  if verdict[:state] == "blocked" && (d = AgentsKanban::SessionDialog.parse(text))
    verdict[:dialog] = d.slice(:question, :command, :options, :escape, :free_text, :hash).merge(answerable: sock == "default")
  end
  verdict
end

# Each pane's previous ↓ count, so a rise between two reads names it writing (Busyyaks::AgentActivity.settle): this
# process's memory only — a restart starts every pane at "no previous read" (phase nil until the next read).
ACTIVITY_MEMO = {}
ACTIVITY_LOCK = Mutex.new

def settled_activity(key, activity)
  ACTIVITY_LOCK.synchronize do
    now = Busyyaks::Clock.monotonic
    ACTIVITY_MEMO.delete_if { |_, m| now - m[:at] > Busyyaks::AgentActivity::STREAM_WINDOW_S } # panes gone or quiet
    act, memo = Busyyaks::AgentActivity.settle(activity, ACTIVITY_MEMO[key], now)
    memo ? ACTIVITY_MEMO[key] = memo : ACTIVITY_MEMO.delete(key)
    act
  end
end

# ── reap: stop agent tmux sessions that are not working ──────────────────────────────────────────────
# Eligible = an agent session (in the collector snapshot) that is NOT attached, has no pane waiting on the
# operator, no pane busy, no pane whose screen shows a dialog or a running turn, no subagent running, and either a pane the record says is idle, or — when no pane's
# state is readable — tmux activity older than REAP_QUIET_S. Everything else is kept. A stale snapshot
# means nobody can tell who is working: refused outright.
REAP_QUIET_S = 30 * 60

def reap_candidates(now = Busyyaks::Clock.now.to_f)
  snap = launched_agents
  return snap unless snap[:ok]
  raise ReapRefused, "collector snapshot is #{snap[:age_s]}s old — cannot tell who is working" if snap[:age_s].to_f > 3 * snap[:interval_s].to_f

  protect = reap_protect
  snap[:sessions].filter_map do |s|
    reason = reap_reason(s, now, protect)
    reason && { name: s["name"], socket: s["socket"], reason: reason, activity: s["activity"],
                project_path: s["panes"].map { |p| p["project_path"] }.compact.first,
                engines: s["panes"].map { |p| p["engine"] }.uniq, title: s["panes"].map { |p| p["title"] }.compact.first }
  end
end

class ReapRefused < StandardError; end

def reap_protect
  list = YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml")).fetch("reap_protect")
  raise "reap_protect must be a list" unless list.is_a?(Array)

  list
end

def reap_reason(s, now, protect = reap_protect)
  return nil if protect.any? { |pat| File.fnmatch?(pat, s["name"].to_s) } # owned by a service (config reap_protect)

  panes = s["panes"]
  return nil if panes.empty? || s["attached"].to_i.positive?
  return nil if panes.any? { |p| p["waiting_for"] || p["status"] == "busy" || p["subagents_running"].to_i.positive? }
  return nil if panes.any? { |p| %w[blocked working].include?(p["screen"]&.dig(:state)) } # its screen: a dialog, or a turn running
  # a subagent count the collector could not read (null: card #479's collector reads none) is unknown, never 0: only the
  # agent's own record saying idle stops it (Claude Code's record says "shell", not idle, while background work runs —
  # the collector reads that as status null), and a quiet session with an unreadable state is kept
  return "idle" if panes.any? { |p| p["status"] == "idle" }
  return nil if panes.any? { |p| p["subagents_running"].nil? }

  quiet = now - s["activity"].to_f
  return nil unless panes.all? { |p| p["status"].nil? || p["status"] == "unknown" } && quiet > REAP_QUIET_S

  "state unreadable, 0 subagents, quiet #{(quiet / 60).round} min"
end

def reap_preview
  { ok: true, quiet_min: REAP_QUIET_S / 60, candidates: reap_candidates }
rescue ReapRefused => e
  { ok: false, error: e.message, status: 409 }
end

# Stops only the named sessions that are STILL eligible in a fresh snapshot; reports each one.
def reap(req)
  wanted = Array(req["sessions"]).map { |x| [x["name"].to_s, (x["socket"] || "default").to_s] }
  raise ArgumentError, "sessions: give at least one {name, socket}" if wanted.empty?

  eligible = reap_candidates.to_h { |c| [[c[:name], c[:socket]], c] }
  results = wanted.map do |name, sock|
    c = eligible[[name, sock]]
    next { name: name, stopped: false, reason: "no longer eligible (working, waiting, attached or gone)" } unless c
    next { name: name, stopped: false, reason: "socket #{sock} is not the default tmux server" } unless sock == "default"

    _o, err, ok = tmux("kill-session", "-t", "=#{name}")
    puts "#{Busyyaks::Clock.now.iso8601} reap #{name} (#{c[:reason]}): #{ok ? 'stopped' : err.strip}"
    { name: name, stopped: ok, reason: ok ? c[:reason] : "tmux: #{err.strip}" }
  end
  STAGE_LOCK.synchronize { sweep_stages("reap") }
  { ok: true, results: results }
rescue ReapRefused => e
  { ok: false, error: e.message, status: 409 }
end

# ── stop: the operator's "Stop" / "Stop all" on a project page ─────────────────────────────────────────
# Kills the named tmux sessions whatever they are doing (the operator clicked and confirmed), but ONLY sessions whose
# pane is in this project's directory (`path` = the container path the page shows) and never one owned by a service
# (config reap_protect). Every name gets its own result; anything not stopped says why.
def stop_op(req)
  path = req["path"].to_s
  names = Array(req["sessions"]).map(&:to_s)
  raise ArgumentError, "path is required (the project's container path)" if path.empty?
  raise ArgumentError, "sessions: give at least one session name" if names.empty?

  live = sessions.to_h { |s| [s[:name], s] }
  every, = live_session_names # every tmux name: a hand-run session is said as such, never "not running"
  protect = reap_protect
  results = names.uniq.map do |name|
    s = live[name]
    unless s
      next { name: name, stopped: false, reason: "not started by busyyaks" } if every&.include?(name)

      next { name: name, stopped: false, reason: "not running" }
    end
    next { name: name, stopped: false, reason: "not started by busyyaks" } unless s[:launched]
    next { name: name, stopped: false, reason: "not in this project (#{s[:project_path] || s[:path]})" } unless s[:project_path] == path
    next { name: name, stopped: false, reason: "protected by reap_protect" } if protect.any? { |pat| File.fnmatch?(pat, name) }

    _o, err, ok = tmux("kill-session", "-t", "=#{name}")
    puts "#{Busyyaks::Clock.now.iso8601} stop #{name} (operator, #{path}): #{ok ? 'stopped' : err.strip}"
    { name: name, stopped: ok, reason: ok ? "stopped" : "tmux: #{err.strip}" }
  end
  STAGE_LOCK.synchronize { sweep_stages("stop") }
  { ok: true, results: results }
end

# ── notify: type a busyyaks message into a card owner's session ──────────────────────────────────────
# Through the collector's own input op ("send": bracketed paste + Enter, refused unless the snapshot's engine is
# still alive in that pane). Before forwarding: the session must be in a fresh snapshot (else gone), must not
# show a question dialog (a paste would answer it — retry later), and every pane's engine must be of a family that
# takes typed input mid-turn (Engines::Family#typeable?: Claude Code queues it; Hermes only as a process this launcher
# started in queue mode, hermes_queue_proof, and only while its composer is the plain prompt).
def notify(req)
  name = req["session"].to_s
  sock = (req["socket"] || "default").to_s
  text = req["text"].to_s
  raise ArgumentError, "bad session" unless name.match?(/\A[A-Za-z0-9._-]{1,100}\z/) && sock.match?(/\A[\w.-]{1,64}\z/)
  # only a session busyyaks started (launched?): one not running is gone, one started by hand is never typed into —
  # both fail the ping at once (the notifier's `gone` / `unsupported`), never retried until the give-up
  in_flight = STAGE_LOCK.synchronize { IN_FLIGHT.include?(name) }
  pids = in_flight ? {} : pane_pids
  stop = Busyyaks::LauncherRules.notify_refusal(name, in_flight: in_flight, pids: pids,
                                                      launched: !in_flight && launched?(name, pids, sock))
  return stop if stop
  raise ArgumentError, "text must be 1..8000 characters" if text.strip.empty? || text.length > 8000

  snap = agents
  return snap unless snap[:ok]
  return { ok: false, retry: true, error: "collector snapshot is #{snap[:age_s]}s old" } if snap[:age_s].to_f > 3 * snap[:interval_s].to_f

  s = snap[:sessions].find { |x| x["name"] == name && x["socket"] == sock }
  # absent from a snapshot whose walk failed (a tmux server that errored or timed out drops its sessions): unknown, not
  # gone — the ping waits for a snapshot that read them
  return { ok: false, retry: true, error: "session #{name} not in the snapshot, which failed: #{snap[:collector_error]}" } if !s && snap[:collector_error]
  return { ok: false, gone: true, error: "session #{name} is not running" } unless s

  panes = s["panes"]
  return { ok: false, retry: true, error: "a question is on its screen" } if panes.any? { |p| p["waiting_for"] }

  proof = hermes_queue_proof(name, sock, panes)
  untypeable = ENGINES.untypeable(panes.map { |p| p["engine"] }, proven: !proof.nil?)
  return { ok: false, unsupported: true, error: "cannot type into #{untypeable.map { |n, why| "#{n} (#{why})" }.join(', ')}" } if untypeable.any?

  # The screen NOW, read by the collector (parse_dialog): any dialog on it — a question, the folder-trust prompt,
  # a permission ask — means a paste + Enter would ANSWER it (the trust prompt's default is "No, exit"). Wait.
  screen = collector(op: "screen", session: name, socket: sock)
  return { ok: false, retry: true, error: "cannot read its screen: #{screen.dig('error', 'message')}" } unless screen["ok"]
  return { ok: false, retry: true, error: "a dialog is on its screen (#{screen.dig('dialog', 'kind') || 'question'})" } if screen["dialog"]
  return { ok: false, retry: true, error: "a dialog is on its screen" } if screen["text"].to_s.match?(/Enter to confirm|Do you trust|Yes, I trust this folder/i)

  panes.each do |p|
    why = ENGINES.fetch(p["engine"]).family.paste_refusal(screen["text"])
    return { ok: false, retry: true, error: why } if why
  end

  res = collector(op: "send", session: name, socket: sock, text: text)
  puts "#{Busyyaks::Clock.now.iso8601} notify #{name}: #{res['ok'] ? 'sent' : res.dig('error', 'message')}"
  return { ok: true } if res["ok"]

  type = res.dig("error", "type")
  message = res.dig("error", "message") || "collector refused"
  # a send whose outcome is unknown — the paste had started (unconfirmed) or the collector never answered (collector) —
  # may already be on the agent's screen: it is never sent again. `unsupported` is the key the notifier ends a ping on.
  return { ok: false, unsupported: true, unconfirmed: true, error: "outcome unknown, not resent (it may have been typed): #{message}" } if %w[unconfirmed collector].include?(type)
  # a dialog, or an input holding something else: the ping stays pending with this reason on its card, and the notifier
  # fails it visibly after its give-up time. Nothing was typed over it
  # paste_unconfirmed: pasted, never seen in the input: failed at once and shown, because a retry could paste it twice
  return { ok: false, unsupported: true, error: message } if type == "paste_unconfirmed"

  { ok: false, retry: %w[tmux dialog input_busy input_unreadable].include?(type), error: message }
rescue Errno::ENOENT, Errno::ECONNREFUSED, Errno::EACCES => e
  { ok: false, retry: true, error: "collector read socket unavailable: #{e.class}" }
end

# The session's one pane runs the Hermes process this launcher recorded in queue mode → that proof, else nil
def hermes_queue_proof(name, sock, panes)
  return nil unless panes.size == 1 && ENGINES.known?(panes[0]["engine"]) &&
                    ENGINES.fetch(panes[0]["engine"]).family.typeable_with_proof?

  # the agent's pid is in the collector's snapshot only: `agents` does not hand it on
  raw = JSON.parse(File.read(COLLECTOR.snapshot)).fetch("sessions").find { |s| s["name"] == name && s["socket"] == sock }
  pid = raw && raw.fetch("panes").first["pid"]
  ticks = pid && proc_start_ticks(pid)
  ticks && HERMES_BOARD.proof(name, pid, ticks)
rescue SystemCallError, JSON::ParserError, KeyError
  nil
end

# ── dialogs: the screen of an owner session blocked on a dialog, and the operator's key press ──────────
# Read with tmux capture-pane (any session, not only collector-tracked ones) and parsed by the same SessionDialog the
# container uses, so the hash the card carries is the hash compared here. Only the default tmux server.
def dialog_session!(req)
  name = req["session"].to_s
  sock = (req["socket"] || "default").to_s
  raise ArgumentError, "bad session" unless name.match?(/\A[A-Za-z0-9._-]{1,100}\z/) && sock.match?(/\A[\w.-]{1,64}\z/)
  raise ArgumentError, "socket #{sock} is not the default tmux server" unless sock == "default"

  name
end

# A session busyyaks may act on: one it started (launched?). Every op that types into, answers, attaches to, reads or
# stops a named session asks this first — a session started by hand is never touched.
def started_by_busyyaks!(name)
  return name if launched?(name)

  raise ArgumentError, "session #{name.inspect} is not a session busyyaks started: busyyaks never touches it"
end

# A NEW session's name (the launch op): it must carry the prefix every busyyaks session carries
def busyyaks_name!(name)
  return name if Busyyaks::LauncherRules.busyyaks_session?(name)

  raise ArgumentError, "session #{name.inspect} has no #{Busyyaks::LauncherRules::SESSION_PREFIX.inspect} prefix: every " \
                       "session busyyaks starts is named so (agent settings session_name)"
end

def dialog_op(req)
  name = started_by_busyyaks!(dialog_session!(req))
  _o, _e, ok = tmux("has-session", "-t", "=#{name}")
  return { ok: false, gone: true, error: "session #{name} is not running" } unless ok

  { ok: true, dialog: AgentsKanban::SessionDialog.parse(pane_text(name)) }
end

# WHERE a session works (the idle watch: which branch's PR to check, how long since a commit): its pane's dir,
# relative to PROJECTS_ROOT. No git runs here — a session's checkout is a repo the host must not run git in (its config
# can name programs); the notifier reads it through its GitRead child (lib/busyyaks/session_git.rb).
def git_op(req)
  name = started_by_busyyaks!(dialog_session!(req))
  out, _e, ok = tmux("display-message", "-p", "-t", "=#{name}:", "\#{pane_current_path}")
  return { ok: false, gone: true, error: "session #{name} is not running" } unless ok

  root = File.realpath(PROJECTS_ROOT)
  path = begin
    File.realpath(out.strip)
  rescue SystemCallError => e
    return { ok: false, error: "the pane's dir #{out.strip} cannot be resolved: #{e.message}" }
  end
  return { ok: false, error: "#{path} is not under PROJECTS_ROOT" } unless path == root || path.start_with?("#{root}/")

  { ok: true, path: path == root ? "." : path.delete_prefix("#{root}/") }
end

ANSWER_KEYS = /\A(\d{1,2}|esc)\z/

# Re-captures the screen and presses the key only if the dialog there has the hash the operator saw, and the key is
# one of its non-free options (or esc when Esc cancels). Anything else is refused with the reason; nothing is typed.
def answer_op(req)
  name = started_by_busyyaks!(dialog_session!(req))
  key = req["key"].to_s
  raise ArgumentError, "key must be a digit or esc" unless key.match?(ANSWER_KEYS)

  _o, _e, ok = tmux("has-session", "-t", "=#{name}")
  return { ok: false, error: "session #{name} is not running — nothing typed", status: 409 } unless ok

  refusal = AgentsKanban::SessionDialog.refuse_answer(pane_text(name), hash: req["hash"], key: key)
  return { ok: false, error: "#{name}: #{refusal} — nothing typed", status: 409 } if refusal

  _o, err, ok = tmux("send-keys", "-t", "=#{name}:", key == "esc" ? "Escape" : key)
  puts "#{Busyyaks::Clock.now.iso8601} answer #{name}: #{key} #{ok ? 'pressed' : err.strip}"
  ok ? { ok: true, pressed: key } : { ok: false, error: "tmux: #{err.strip}", status: 500 }
end

# ── attach: a session's live terminal ───────────────────────────────────────────────────────────────────────────────
# The screen AND the keys leave the host, to the web's operator-only /api/terminal (and an ssh --stdio relay): an
# explicit reversal of "only the verdict leaves the host" (pane_screen), the operator's call — docs/DEPLOY.md
# § Terminals. A tmux CLIENT of the session in a PTY of ours, `attach-session -f ignore-size,read-only`, for the whole
# stream: the viewer never resizes the agent's window and the client takes no key, ever — a key written into a client
# goes through its key tables (the prefix, `:` + run-shell, new-window, choose-tree: a host shell or another session,
# past every check here). Control is this op's own flag; a key in control is `send-keys -H` (its bytes, in hex) to the
# session's pane, in ONE tmux command after `copy-mode -q` (a pane in a mode — copy mode, choose-tree — hands even literal keys to that
# mode's key table, where a binding may run-shell): the mode is cancelled, then the agent reads the bytes typed.
# Refused here while not in control, not only by the web. The client showing any other session (the session ended and
# tmux moved it) ends the stream.
# Only a running session with an agent in its pane (claude, or an allowlisted launch command) is attached, and taking
# control checks that again.
ATTACH_POLL_S = 2 # how often the window's size is read (a resize is sent as {"size"})

def attach_refusal(error, status) = { ok: false, error: error, status: status }

def attach_base(sock) = sock == "default" ? [] : ["-L", sock]

def agent_pane?(base, name)
  out, _e, ok = tmux(*base, "display-message", "-p", "-t", "=#{name}:", "\#{pane_pid}")
  return false unless ok

  names = ["claude", *COMMANDS.map { |c| c["command"] }].uniq
  tree(out.strip.to_i).any? do |pid|
    argv = (File.read("/proc/#{pid}/cmdline") rescue "").split("\0")
    argv.first(2).any? { |a| names.include?(File.basename(a)) }
  end
end

# The size a client of the session's window has: the window plus its status line(s) (a client of another size would
# make tmux redraw the window cropped or padded — and, the only client, resize it).
def window_size(base, name)
  out, _e, ok = tmux(*base, "display-message", "-p", "-t", "=#{name}:", "\#{window_width} \#{window_height} \#{status}")
  cols, rows, status = out.split
  lines = { "on" => 1, "off" => 0 }.fetch(status.to_s) { status.to_i }
  ok && cols.to_i.positive? && rows.to_i.positive? ? [cols.to_i, rows.to_i + lines] : nil
end

def attach_check(req)
  name, sock = Busyyaks::Terminal.session!(req["session"], req["socket"] || "default")
  base = attach_base(sock)
  _o, _e, ok = tmux(*base, "has-session", "-t", "=#{name}")
  return attach_refusal("session #{name} is not running", 404) unless ok
  unless launched?(name, pane_pids, sock)
    return attach_refusal("session #{name} is not a session busyyaks started: never attached", 403)
  end
  return attach_refusal("session #{name} runs no agent in its pane (claude or a launch command): not attached", 403) \
    unless agent_pane?(base, name)

  size = window_size(base, name) or return attach_refusal("session #{name}: its window size is unreadable", 500)
  [name, sock, base, size]
rescue Busyyaks::Terminal::Invalid => e
  attach_refusal(e.message, 400)
end

def attach_op(io, req)
  checked = attach_check(req)
  return io.puts(JSON.generate(checked)) if checked.is_a?(Hash)

  name, sock, base, (cols, rows) = checked
  screen, = tmux(*base, "capture-pane", "-e", "-p", "-t", "=#{name}:")
  master, slave = PTY.open
  tty = slave.path
  master.winsize = [rows, cols]
  pid = Process.spawn(TMUX_ENV.merge("TERM" => "xterm-256color"), "tmux", *base, "attach-session", "-f", "ignore-size,read-only",
                      "-t", "=#{name}", in: slave, out: slave, err: slave, pgroup: true)
  slave.close
  io.puts(JSON.generate(ok: true, session: name, cols: cols, rows: rows,
                        screen: [screen.to_s.gsub(/\r?\n/, "\r\n")].pack("m0")))
  puts "#{Busyyaks::Clock.now.iso8601} attach #{name}: opened (read-only)"
  out = Thread.new { attach_output(io, master, base, name, [cols, rows], tty) }
  attach_input(io, base, name)
ensure
  Process.kill("TERM", pid) rescue nil if pid
  Process.wait(pid) rescue nil if pid
  out&.join(5)
  master&.close unless master&.closed?
  puts "#{Busyyaks::Clock.now.iso8601} attach #{name}: closed" if pid
end

def monotonic = Busyyaks::Clock.monotonic

# our client still shows this session, or the stream ends here: detached, logged, EOFError (nothing more is sent)
def attach_on_session!(base, name, tty)
  shown = client_session(base, tty)
  return if shown == name

  tmux(*base, "detach-client", "-t", tty) if shown
  puts "#{Busyyaks::Clock.now.iso8601} attach #{name}: the client showed #{(shown || 'no session').inspect}, detached"
  raise EOFError
end

# the session our client (by its tty) shows now, nil when it is gone
def client_session(base, tty)
  out, = tmux(*base, "list-clients", "-F", "\#{client_tty} \#{client_session}")
  out.lines.map(&:split).find { |l| l.first == tty }&.last
end

# the tmux client's output → {"o"}; the window resized → {"size"}; the client gone, or showing another session
# (tmux moves a client when its session is destroyed, detach-on-destroy off) → {"exit"}, the stream ends. The client's
# session is asked before EVERY chunk is sent (one list-clients each): no byte of another session leaves; the size
# every ATTACH_POLL_S whatever the output (a session that redraws all the time must not starve it).
def attach_output(io, master, base, name, size, tty)
  checked = monotonic
  loop do
    if IO.select([master], nil, nil, ATTACH_POLL_S)
      chunk = master.readpartial(16_384)
      # asked AFTER the read, before the write: tmux moves the client (and redraws the other session) before any byte
      # of that session reaches us, so a chunk read while the client still shows this session is this session's
      attach_on_session!(base, name, tty)
      io.write(Busyyaks::Terminal.output(chunk))
    end
    next if monotonic - checked < ATTACH_POLL_S

    checked = monotonic
    attach_on_session!(base, name, tty)
    if (now = window_size(base, name)) && now != size
      size = now
      master.winsize = [size[1], size[0]]
      io.write(Busyyaks::Terminal.line(size: { cols: size[0], rows: size[1] }))
    end
  end
rescue EOFError, Errno::EIO
  io.write(Busyyaks::Terminal.line(exit: "the tmux client ended: the session is gone or the client detached")) rescue nil
  io.close_write rescue nil
rescue IOError, SystemCallError
  nil
end

# the client's frames: keys only in control, typed into the pane (attach_keys); the tmux client never gets one
def attach_input(io, base, name)
  control = false
  while (line = io.gets("\n", Busyyaks::Terminal::MAX_LINE))
    begin
      kind, value = Busyyaks::Terminal.client_frame(line)
    rescue Busyyaks::Terminal::Invalid => e
      io.write(Busyyaks::Terminal.refused(e.message))
      next
    end
    if kind == :input
      next io.write(Busyyaks::Terminal.refused(Busyyaks::Terminal::NOT_IN_CONTROL)) unless control

      attach_keys(io, base, name, value)
    else
      control = attach_control(io, base, name, control, value)
    end
  end
rescue IOError, SystemCallError
  nil
end

# keys → the session's pane: `copy-mode -q ; send-keys -H <hex>…` in one tmux command — any mode of the pane cancelled
# first (a mode's key table would take the keys), then each byte as a hex key: no key-name lookup, no client and so no
# client key table, and no argument tmux could read as its own (a trailing ";" ends a tmux command — `-l` lost it,
# silently). Any byte goes as typed, NUL and UTF-8 alike. tmux refuses a command over 16 KB (its message size) and a
# hex key costs 3 bytes there, so a frame (a paste, MAX_INPUT 64 KB) goes in ATTACH_KEYS_CHUNK pieces, in order, each
# with its own mode cancel; a piece tmux refuses stops the rest, and the refusal says how much was typed.
ATTACH_KEYS_CHUNK = 4096 # × 3 bytes + the two commands with a 100-character session name ≈ 12.6 KB of tmux's 16 KB

def attach_keys(io, base, name, keys)
  target = "=#{name}:"
  bytes = keys.b
  (0...bytes.bytesize).step(ATTACH_KEYS_CHUNK) do |at|
    hex = bytes.byteslice(at, ATTACH_KEYS_CHUNK).unpack("C*").map { |b| format("%02x", b) }
    _o, err, ok = tmux(*base, "copy-mode", "-q", "-t", target, ";", "send-keys", "-t", target, "-H", *hex)
    next if ok

    return io.write(Busyyaks::Terminal.refused("tmux send-keys failed after #{at} of #{bytes.bytesize} bytes: #{err.strip}"))
  end
end

# Take control: the session is still running with an agent in its pane (as at attach) — else refused, control stays
# off. Release: always. Nothing is asked of tmux's client: it stays read-only.
def attach_control(io, base, name, control, want)
  if want && !control
    _o, _e, up = tmux(*base, "has-session", "-t", "=#{name}")
    why = if !up then "session #{name} is not running"
          elsif !launched?(name, pane_pids, base.empty? ? "default" : base.last) then "session #{name} is not a session busyyaks started"
          elsif !agent_pane?(base, name) then "session #{name} runs no agent in its pane"
          end
    if why
      io.write(Busyyaks::Terminal.refused("#{why}: control stays off"))
      return false
    end
  end
  puts "#{Busyyaks::Clock.now.iso8601} attach #{name}: control #{want ? 'taken' : 'released'}" if want != control
  io.write(Busyyaks::Terminal.line(control: want))
  want
end

# One request to the collector's read socket → its answer, within agents.collector.answer_timeout_seconds for the
# whole answer line (card #479: a collector that accepts and never answers costs that, never a parked launcher). A
# collector that does not answer, closes early or answers no JSON → an error answer naming it ({ok:false, error:
# {type, message}}, type collector — a send it did not confirm may still have been typed: notify never resends it).
def collector(req)
  why = "agent-session collector #{COLLECTOR.read_socket}"
  line = UNIXSocket.open(COLLECTOR.read_socket) do |u|
    u.puts(JSON.generate(req))
    Busyyaks::AgentCollector.read_line(u, COLLECTOR.answer_timeout_seconds, max: Busyyaks::AgentCollector::ANSWER_MAX)
  end
  return collector_error("#{why} closed the socket without an answer") if line.nil?

  res = JSON.parse(line)
  res.is_a?(Hash) ? res : collector_error("#{why} answered no JSON object")
rescue Busyyaks::AgentCollector::Slow
  collector_error("#{why} did not answer within #{COLLECTOR.answer_timeout_seconds}s")
rescue Errno::EPIPE, Errno::ECONNRESET => e
  collector_error("#{why} dropped the connection (#{e.class})") # the request may have been taken: an unknown outcome
rescue Busyyaks::AgentCollector::TooLarge, JSON::ParserError => e
  collector_error("#{why}: #{e.is_a?(JSON::ParserError) ? 'its answer is not JSON' : e.message}")
end

def collector_error(message) = { "ok" => false, "error" => { "type" => "collector", "message" => message } }

# One session's subagents / workflows / background tasks from the collector's read socket. Only the
# read-only "tasks" op is ever forwarded (that socket also takes input for interactive sessions).
def agent_tasks(req)
  name = req["session"].to_s
  sock = req["socket"].to_s
  raise ArgumentError, "bad session" unless name.match?(/\A[^\x00-\x1f]{1,200}\z/) && sock.match?(/\A[\w.-]{1,64}\z/)
  raise ArgumentError, "session #{name.inspect} is not a session busyyaks started" unless launched?(name, pane_pids, sock)

  res = collector(op: "tasks", session: name, socket: sock)
  return res if res["ok"]

  { ok: false, error: res.dig("error", "message") || "collector refused", status: res.dig("error", "type") == "collector" ? 503 : 404 }
rescue Errno::ENOENT, Errno::ECONNREFUSED, Errno::EACCES => e
  { ok: false, error: "collector read socket unavailable: #{e.class}", status: 503 }
end

# --- the projects dir (card 532): PROJECTS_ROOT is every container's mount source, so only this host process changes it
APPLY = { lock: Mutex.new, running: false }

def on_path(program)
  ENV.fetch("PATH", "").split(":").map { |d| File.join(d, program) }.find { |f| File.file?(f) && File.executable?(f) }
end

def projects_root_plan(path)
  trusted = Busyyaks::LaunchTrust.parse!(YAML.safe_load_file(File.join(ROOT, "config/busyyaks.yml"))["launch"])
  apart = { "LAUNCHER_RUN_DIR" => RUN_DIR, "LAUNCHER_STATE_DIR" => STATE_DIR }
  apart["the agent collector's dir"] = File.dirname(COLLECTOR.snapshot) if COLLECTOR
  Busyyaks::ProjectsRoot.plan(path.to_s, current: PROJECTS_ROOT, container_root: CONTAINER_ROOT, roots: roots,
                                         trusted: trusted, apart: apart, not_inside: { "./data" => File.join(ROOT, "data") },
                                         created: CREATED.paths, docker: on_path("docker"))
end

def projects_root_op(req)
  case req["step"]
  when "plan" then { ok: true, plan: projects_root_plan(req["path"]) }
  when "apply" then projects_root_apply(req)
  when "status"
    # the flag and the record read together: an apply ends by writing its record and clearing the flag under this lock
    running, last = APPLY[:lock].synchronize { [APPLY[:running], Busyyaks::ProjectsRoot.state(STATE_DIR)] }
    { ok: true, current: PROJECTS_ROOT, applying: running,
      last: Busyyaks::ProjectsRoot.settled(last, current: PROJECTS_ROOT, running: running), }
  else { ok: false, error: "step must be plan, apply or status", status: 400 }
  end
rescue Busyyaks::ProjectsRoot::Invalid, Busyyaks::LaunchTrust::Invalid => e
  { ok: false, error: e.message, status: 422 }
end

# The plan is checked again and must be the one the operator saw (its id); then .env is rewritten and compose recreates
# the services on a thread (the web answering this request is one of them). Success → recorded, this launcher exits
# and systemd starts it on the new .env. Failure → the old .env back, compose up again on it, recorded with the reason.
def projects_root_apply(req)
  plan = projects_root_plan(req["path"])
  unless plan[:plan_id] == req["plan_id"]
    return { ok: false, error: "the plan changed since it was checked: check again", status: 409 }
  end

  env = File.join(ROOT, ".env")
  # the flag and the "applying" record set in one step under APPLY's lock (as the failure record and the flag's end
  # are): a status never reads a running apply beside the last one's record
  rec = APPLY[:lock].synchronize do
    return { ok: false, error: "a projects dir change is already running", status: 409 } if APPLY[:running]

    projects_root_start(plan, env).tap { APPLY[:running] = true }
  end
  puts "#{Busyyaks::Clock.now.iso8601} projects dir #{plan[:from]} → #{plan[:to]}: .env rewritten (backup #{rec['backup']}), compose up"
  Thread.new { projects_root_compose(rec, env, rec["backup"]) }
  { ok: true, state: rec }
end

# .env rewritten (its backup kept) and the "applying" record written; on a failure nothing started: a .env already
# rewritten goes back before the refusal
def projects_root_start(plan, env)
  stamp = Busyyaks::Clock.now.utc.strftime("%Y%m%dT%H%M%SZ")
  backup = Busyyaks::ProjectsRoot.write_env!(env, plan[:to], stamp: stamp, backup_dir: STATE_DIR)
  rec = { "state" => "applying", "from" => plan[:from], "to" => plan[:to], "at" => Busyyaks::Clock.now.iso8601,
          "backup" => backup, "env" => "new", "log" => File.join(STATE_DIR, "projects-root-#{stamp}.log"), }
  Busyyaks::ProjectsRoot.record!(STATE_DIR, rec)
  rec
rescue StandardError
  Busyyaks::ProjectsRoot.restore_env!(env, backup) if backup
  raise
end

# rec["env"] says which .env is in place at every record: "new" until a failed compose puts the old one back
# ("restored") — the page says what it reads, never assumes the rollback ran.
def projects_root_compose(rec, env, backup)
  out, st = Open3.capture2e(*Busyyaks::ProjectsRoot.compose_argv(ROOT), chdir: ROOT, in: File::NULL)
  projects_root_log(rec, out)
  return projects_root_done(rec) if st.success?

  Busyyaks::ProjectsRoot.restore_env!(env, backup)
  rec = rec.merge("env" => "restored")
  back, back_st = Open3.capture2e(*Busyyaks::ProjectsRoot.compose_argv(ROOT), chdir: ROOT, in: File::NULL)
  projects_root_log(rec, "#{out}\n--- rollback: .env restored, compose up ---\n#{back}")
  why = "compose up exit #{st.exitstatus}: #{out.lines.last(3).join.strip}"
  projects_root_failed(rec, why, "rolled_back" => back_st.success?)
  puts "#{Busyyaks::Clock.now.iso8601} projects dir #{rec['to']} FAILED (#{why}); .env restored, rollback compose " \
       "#{back_st.success? ? 'ok' : "exit #{back_st.exitstatus}"}"
rescue StandardError => e
  projects_root_failed(rec, "#{e.class}: #{e.message}")
  puts "#{Busyyaks::Clock.now.iso8601} projects dir #{rec['to']} FAILED: #{e.class}: #{e.message} (.env: #{rec['env']})"
ensure
  APPLY[:lock].synchronize { APPLY[:running] = false }
end

# the compose output, best-effort: a log that cannot be written never decides what happens next (a compose that
# succeeded still restarts the launcher; one that failed still rolls back)
def projects_root_log(rec, text)
  File.write(rec["log"], text, perm: 0o600)
rescue StandardError => e
  puts "#{Busyyaks::Clock.now.iso8601} projects dir #{rec['to']}: log #{rec['log']} NOT written (#{e.class}: #{e.message})"
end

# compose ran on the new .env: the launcher restarts on it whether or not the record could be written (the services
# already run on the new dir; a launcher left on the old one would map every path wrong)
def projects_root_done(rec)
  begin
    Busyyaks::ProjectsRoot.record!(STATE_DIR, rec.merge("state" => "done", "done_at" => Busyyaks::Clock.now.iso8601))
  rescue StandardError => e
    puts "#{Busyyaks::Clock.now.iso8601} projects dir #{rec['to']}: compose ok, record NOT written (#{e.class}: #{e.message})"
  end
  puts "#{Busyyaks::Clock.now.iso8601} projects dir now #{rec['to']}: restarting the launcher on the new .env"
  Process.kill("TERM", Process.pid)
end

# the failure record and the end of the apply in one step under APPLY's lock: a status never reads "failed" while
# the apply still counts as running
def projects_root_failed(rec, why, extra = {})
  APPLY[:lock].synchronize do
    Busyyaks::ProjectsRoot.record!(STATE_DIR, rec.merge("state" => "failed", "error" => why,
                                                        "done_at" => Busyyaks::Clock.now.iso8601).merge(extra))
  ensure
    APPLY[:running] = false
  end
rescue StandardError => e
  puts "#{Busyyaks::Clock.now.iso8601} projects dir #{rec['to']}: failure record NOT written (#{e.class}: #{e.message})"
end

# --- updates (card 536): config/busyyaks.yml updates is read on every op (an edit applies without a restart)
# check: one check at a time · spawn: one apply at a time (held through its check) · flag: the background check's
# flag — its own lock, so a status never waits behind an apply's check
UPDATE = { check: Mutex.new, spawn: Mutex.new, flag: Mutex.new, checking: false, error: nil, child: nil }

# bin/yaks of this checkout, its exit kept: the launcher runs no git of its own (launcher_rules_test) — the check and
# the update are `yaks update`'s, whose every git call has its own deadline (Updates::GIT_TIMEOUT_S), so this returns
def update_yaks(*args)
  Open3.capture3(RbConfig.ruby, File.join(ROOT, "bin", "yaks"), "update", *args, chdir: ROOT, in: File::NULL)
end

# one check at a time (`yaks update --check --json`, which also writes update-check.json); its failure is kept (with
# the time) and shown — the older check stays on screen with its own time, never read as "up to date"
def update_check!
  UPDATE[:check].synchronize do
    out, err, st = update_yaks("--check", "--json")
    unless st.success?
      why = err.to_s.strip.sub(/\Ayaks: /, "")
      why = "yaks update --check exited #{st.exitstatus}" if why.empty?
      UPDATE[:error] = { "at" => Busyyaks::Clock.now.iso8601, "error" => why }
      raise Busyyaks::Updates::Refused, why
    end
    UPDATE[:error] = nil
    JSON.parse(out, symbolize_names: true)
  rescue JSON::ParserError => e
    UPDATE[:error] = { "at" => Busyyaks::Clock.now.iso8601, "error" => "yaks update --check --json: #{e.message}" }
    raise Busyyaks::Updates::Refused, UPDATE[:error]["error"]
  end
end

# a check is asked again when there is none, the settings it was made for changed, it is older than check_minutes, or
# it saw another HEAD than the one the last finished update left
def update_stale?(settings, check, last)
  return true unless check.is_a?(Hash) && check["checked_at"] && check.dig("head", "sha")
  return true if check["remote"] != settings.remote || check.dig("branch", "name") != settings.branch ||
                 check["channel"] != settings.channel
  at = Time.iso8601(check["checked_at"])
  return true if Busyyaks::Clock.now - at > settings.check_seconds

  last.is_a?(Hash) && last["state"] == "done" && last["to"].is_a?(String) && last["to"] != check.dig("head", "sha")
rescue ArgumentError
  true
end

def update_running? = UPDATE[:child]&.alive? || Busyyaks::Updates.running?(STATE_DIR)

# a failed check is asked again only after check_minutes (or "Check now"): a broken remote is not fetched on every poll
def update_backing_off?(settings)
  err = UPDATE[:error]
  err && Busyyaks::Clock.now - Time.iso8601(err["at"]) < settings.check_seconds
end

# The record as it stands: one that says starting / running while no update holds the lock (nor the child this
# launcher started runs) was left by an update that died — said as interrupted, with the step it reached and its log;
# never read as still running (which would hold every Update button off) nor as done
def update_last(running)
  last = Busyyaks::Updates.read_json(STATE_DIR, Busyyaks::Updates::RECORD_FILE)
  return last unless last.is_a?(Hash) && %w[starting running].include?(last["state"]) && !running

  last.merge("state" => "interrupted",
             "error" => "the update stopped at #{last['step'] || 'its start'} without finishing (killed, or the host " \
                        "restarted): see #{last['log'] || 'its log'}; the checkout and the stack are as that step left them")
end

def update_status(settings)
  check = Busyyaks::Updates.read_json(STATE_DIR, Busyyaks::Updates::CHECK_FILE)
  running = update_running?
  last = update_last(running)
  if update_stale?(settings, check, last) && !running && !update_backing_off?(settings)
    UPDATE[:flag].synchronize do
      unless UPDATE[:checking]
        UPDATE[:checking] = true
        Thread.new do
          update_check!
        rescue StandardError => e
          puts "#{Busyyaks::Clock.now.iso8601} update check FAILED: #{e.message}"
        ensure
          UPDATE[:flag].synchronize { UPDATE[:checking] = false }
        end
      end
    end
  end
  { ok: true, settings: settings.to_h, check: check, checking: UPDATE[:checking], check_error: UPDATE[:error],
    running: running, last: last, }
end

def update_apply(settings, req)
  mode = req["mode"].to_s
  sha = req["sha"].to_s
  return { ok: false, error: "sha must be the 40-hex commit the page showed", status: 400 } unless sha.match?(Busyyaks::Updates::SHA)

  UPDATE[:spawn].synchronize do
    return { ok: false, error: "an update is already running", status: 409 } if update_running?

    check = update_check!
    Busyyaks::Updates.target!(check, settings, mode: mode, expect: sha)
    stamp = Busyyaks::Clock.now.utc.strftime("%Y%m%dT%H%M%SZ")
    log = File.join(STATE_DIR, "update-#{stamp}.log")
    argv = [RbConfig.ruby, File.join(ROOT, "bin", "yaks"), "update", *("--main" if mode == "branch"), "--expect", sha,
            "--log", log,]
    # the record before the child runs: a child that dies before its own first write is still on screen (interrupted)
    Busyyaks::Updates.write_json!(STATE_DIR, Busyyaks::Updates::RECORD_FILE,
                                  { "state" => "starting", "step" => nil, "mode" => mode, "to" => sha,
                                    "started_at" => Busyyaks::Clock.now.iso8601, "log" => log, })
    pid = File.open(log, File::WRONLY | File::CREAT | File::TRUNC, 0o600) do |f|
      Process.spawn(*argv, chdir: ROOT, in: File::NULL, out: f, err: f, pgroup: true)
    end
    UPDATE[:child] = Process.detach(pid)
    puts "#{Busyyaks::Clock.now.iso8601} update #{mode} → #{sha[0, 7]} started (pid #{pid}, log #{log}; head #{check.dig(:head, :sha)[0, 7]})"
    { ok: true, started: { pid: pid, log: log, mode: mode, sha: sha } }
  end
end

def update_op(req)
  settings = Busyyaks::Updates.load!(ROOT)
  case req["step"]
  when "status" then update_status(settings)
  when "check" then { ok: true, check: update_check! }
  when "apply" then update_apply(settings, req)
  else { ok: false, error: "step must be status, check or apply", status: 400 }
  end
rescue Busyyaks::Updates::Invalid, Busyyaks::Updates::Refused => e
  { ok: false, error: e.message, status: 422 }
end

def browse_op(req)
  { ok: true, **Busyyaks::ProjectsRoot.browse(req["path"].to_s) }
rescue Busyyaks::ProjectsRoot::Invalid => e
  { ok: false, error: e.message, status: 422 }
end

# What a launch in the repo would do with the repo's own .busyyaks/skills, nothing started (the project page's Settings
# tab, which edits its .busyyaks/skills): {ok, project_skills: "loaded" | "none" | "left: <why>", budget, replace_budget,
# layers: {type => what a launch of it stages, each earlier layer's file marked when the override rule replaced it},
# checkout} — the folder-trust
# decision and the layer's validation are the launch's own (Skills.project_status); an invalid layer is the refusal the
# launch would give.
def project_skills_op(req)
  cfg = board_config(req["settings"])
  dir = host_dir(req["path"])
  refusal = Busyyaks::LaunchTrust.refusal(dir, trusted: TRUSTED, created: CREATED)
  st = Busyyaks::Skills.project_status(checkout: ROOT, repo: dir, types: cfg.agent_type_keys, settings: SKILLS,
                                       trust_refusal: refusal)
  # checkout: the repo is this busyyaks checkout itself — `yaks update` refuses it while a tracked file is uncommitted
  { ok: true, project_skills: st[:status], budget: st[:budget], replace_budget: st[:replace_budget],
    layers: st[:layers], checkout: File.realpath(dir) == File.realpath(ROOT), }
rescue Busyyaks::LaunchTrust::Invalid => e
  { ok: false, error: "folder trust: #{e.message}", status: 422 }
rescue Busyyaks::Skills::Invalid => e
  { ok: false, error: "skills: #{e.message}", status: 422 }
end

# busyyaks's own skills layers as every launch of this checkout reads them (Settings → Agent rules, the project page's
# inherited layers): the files in the order a launch stages them, per agent type of the revision — the launch's own
# selection (Skills.global_view → Skills.layers_answer), nothing staged.
def skills_layers_op(req)
  cfg = board_config(req["settings"])
  { ok: true, **Busyyaks::Skills.layers_answer(checkout: ROOT, types: cfg.agent_type_keys, settings: SKILLS,
                                               projects_root: PROJECTS_ROOT, container_root: CONTAINER_ROOT) }
rescue Busyyaks::Skills::Invalid => e
  { ok: false, error: "skills: #{e.message}", status: 422 }
end

def handle(line)
  req = JSON.parse(line)
  # an op that reads the collector, on a box configured without one (AgentCollector::OPS): OFF, nothing else runs
  refused = Busyyaks::AgentCollector.refusal(COLLECTOR, req["op"])
  return refused if refused

  case req["op"]
  when "name" then name_op(req)
  when "launch" then launch(req)
  when "lead_key" then lead_key_op(req)
  when "sessions"
    STAGE_LOCK.synchronize { sweep_stages("sessions") }
    { ok: true, sessions: sessions }
  when "harnesses" then harnesses_op
  when "create" then create(req)
  when "jobs" then { ok: true, jobs: jobs }
  when "agents" then launched_agents
  when "agent_tasks" then agent_tasks(req)
  when "reap_preview" then reap_preview
  when "reap" then reap(req)
  when "stop" then stop_op(req)
  when "notify" then notify(req)
  when "dialog" then dialog_op(req)
  when "git" then git_op(req)
  when "answer" then answer_op(req)
  when "browse" then browse_op(req)
  when "project_skills" then project_skills_op(req)
  when "skills_layers" then skills_layers_op(req)
  when "projects_root" then projects_root_op(req)
  when "update" then update_op(req)
  else { ok: false, error: "unknown op" }
  end
rescue ArgumentError, KeyError, JSON::ParserError => e
  { ok: false, error: e.message, status: 400 }
rescue StandardError => e
  { ok: false, error: "#{e.class}: #{e.message}", status: 500 }
end

# the last run's socket (a restart, a reboot: RUN_DIR persists) is replaced; anything else there stops the start
if File.symlink?(SOCKET) || (File.exist?(SOCKET) && !File.socket?(SOCKET))
  abort "#{SOCKET} exists and is not a socket (a symlink or a file): remove it"
end
File.unlink(SOCKET) if File.socket?(SOCKET)
# stages of sessions that ended while no launcher ran
STAGE_LOCK.synchronize { sweep_stages("start") }
server = Busyyaks::PrivateSocket.bind(SOCKET) # owner-only from the moment it exists; the umask restored
puts "launcher listening on #{SOCKET}"
puts COLLECTOR ? "agent-session collector: #{COLLECTOR.snapshot} · #{COLLECTOR.read_socket}" : Busyyaks::AgentCollector::OFF
trap("TERM") { File.unlink(SOCKET) rescue nil; exit }
loop do
  client = server.accept
  Thread.new(client) do |c|
    line = c.gets
    req = begin
      line && JSON.parse(line)
    rescue JSON::ParserError
      nil
    end
    # attach keeps the connection: a stream, not one answer (Busyyaks::Terminal)
    next attach_op(c, req) if req.is_a?(Hash) && req["op"] == "attach"

    c.puts(JSON.generate(line ? handle(line) : { ok: false, error: "empty request" }))
  ensure
    c.close
  end
end
