#!/usr/bin/env ruby
# frozen_string_literal: true

# The agent settings revisions from a shell, inside the web container (the DB and config/busyyaks.yml
# launch.commands are there):
#
#   docker compose exec -T web bin/agent-settings show          # the current revision as YAML {launchers, agent_types}
#   docker compose exec -T web bin/agent-settings import < f    # a new revision from YAML on stdin: its launchers +
#                                                               # agent_types (any other key of the file is ignored —
#                                                               # an old config/kanban.yml works as is), checked like
#                                                               # a save on the Settings page
#
# Settings → Agents & launchers on the dashboard does the same; this is for the move off config/kanban.yml (docs/DEPLOY.md).
require "bundler/setup"
require "hanami/prepare"
require "busyyaks/agent_settings_api"

S = Busyyaks::AgentSettings
db = Busyyaks::Kanban.db
case ARGV
in ["show"]
  puts YAML.dump(S.current(db)[:doc])
in ["import"]
  raw = YAML.safe_load($stdin.read)
  abort "bin/agent-settings import: stdin must be a YAML mapping with launchers and agent_types" unless raw.is_a?(Hash)
  status, body = Busyyaks::AgentSettingsAPI.save({ "base" => S.current_id(db), "doc" => raw.slice(*S::KEYS) },
                                                 by: "bin/agent-settings import")
  abort "bin/agent-settings import: #{status}: #{body[:error]}" unless status == 200
  puts "revision #{body[:revision][:id]}: #{body[:doc]['launchers'].map { |l| l['key'] }.join(', ')} · " \
       "#{body[:doc]['agent_types'].map { |t| t['key'] }.join(', ')}"
else
  abort "usage: bin/agent-settings show | bin/agent-settings import < file.yml"
end
