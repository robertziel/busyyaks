#!/usr/bin/env bash
# Daily-report runner "hermes" (config/busyyaks.yml daily_report.runner.type: hermes). Started by
# bin/daily-report — after its gateway probe passed — inside timeout(1) with a clean environment holding only the
# variables below. Writes the Hermes home's config.yaml (the gateway is its only provider), then runs Hermes once:
# the lead reads the repos through the busyyaks MCP, delegates one child per active repo and posts the report with
# post_report. No terminal, no process tool, no git: every fact (subjects, per-commit paths, uncommitted paths) comes
# from the busyyaks MCP (daily_facts), so nothing a repo or a commit message says can run a program on the host.
# Exit status = Hermes's.
set -euo pipefail
: "${DAY:?}" "${GATEWAY:?}" "${LEAD_MODEL:?}" "${AGENT_MODEL:?}" "${CONTEXT_LENGTH:?}" "${MCP_URL:?}" "${BUSYYAKS_MCP_TOKEN_FILE:?}"
: "${USAGE_FILE:?}" "${BUSYYAKS_DIR:?}" "${RUNNER_COMMAND:?}" "${RUNNER_HOME:?}" "${RUNNER_MAX_CHILDREN:?}"

# the MCP bearer arrives as a file (0600, in bin/daily-report's private dir), never in an argv: read into this process's
# environment, which Hermes inherits (the generated config reads ${BUSYYAKS_MCP_TOKEN}); exec keeps it off every cmdline
BUSYYAKS_MCP_TOKEN=$(<"$BUSYYAKS_MCP_TOKEN_FILE")
[ -n "$BUSYYAKS_MCP_TOKEN" ] || { echo "BUSYYAKS_MCP_TOKEN_FILE $BUSYYAKS_MCP_TOKEN_FILE is empty" >&2; exit 2; }
export BUSYYAKS_MCP_TOKEN

home=$RUNNER_HOME
mkdir -p "$home"
# Generated every run from config/busyyaks.yml daily_report (the only source of these values); Hermes's other homes
# are never touched.
cat >"$home/config.yaml" <<YAML
# GENERATED by busyyaks bin/daily-report-runners/hermes on every run — edit config/busyyaks.yml daily_report, not this file.
model:
  default: "$LEAD_MODEL"
  provider: "custom"
  base_url: "$GATEWAY"
  api_mode: chat_completions
  context_length: $CONTEXT_LENGTH
fallback_providers: []
auth:
  adopt_external_logins: false
memory:
  memory_enabled: false
  user_profile_enabled: false
skills:
  creation_nudge_interval: 0
agent:
  max_turns: 150
  reasoning_effort: "low"
approvals:
  mode: "off"
delegation:
  model: "$AGENT_MODEL"
  provider: "custom"
  base_url: "$GATEWAY"
  max_iterations: 60
  max_concurrent_children: $RUNNER_MAX_CHILDREN
  oneshot_max_children: 0
  inherit_mcp_toolsets: false
  fallback_providers: []
auxiliary:
  title_generation:
    enabled: false
  background_review:
    enabled: false
  compression:
    provider: "custom"
    base_url: "$GATEWAY"
    model: "$LEAD_MODEL"
mcp_servers:
  busyyaks:
    url: "$MCP_URL"
    headers:
      Authorization: "Bearer \${BUSYYAKS_MCP_TOKEN}"
    # exactly the busyyaks tools the prompt below calls (a subset of the token's McpServer::REPORT_TOOLS;
    # test/unit/daily_report_runner_test.rb checks both)
    tools:
      include: [daily_facts, project, kanban_card, github_network, report_components, check_report, post_report]
YAML


read -r -d '' PROMPT <<P || true
You are the busyyaks daily reporter for $DAY. The operator reads this at a glance: data, not prose — numbers,
tags, lines of at most 12 words. No paragraphs, no sentence that repeats a number already shown.
Tools: the busyyaks MCP tools are named mcp__busyyaks__<tool>; delegate_task spawns children.
1. FACTS. Call mcp__busyyaks__daily_facts with hours=24, series="Daily report" (the last scan's figures: its last_scan
   says when; never ask for a new scan).
   Every number in the report comes from daily_facts (totals, previous_window, repos, pending, human_input, human_check,
   blocked_external, previous_report.figures) or from the children's summaries — never count by hand, never estimate ("18+" is wrong).
   A number you could not get is left out and said missing, never guessed.
2. ONE CHILD PER ACTIVE REPO: for every entry in daily_facts.repos, one task in a SINGLE delegate_task call
   (tasks=[...], toolsets=["busyyaks"], context_files=false; at most $RUNNER_MAX_CHILDREN tasks per call — more repos →
   further calls). Put the repo's daily_facts entry in each task's goal, as is: subjects (sha + subject),
   churn.commits (each commit's sha and the paths it touched, "more" = paths not listed), dirty_paths (uncommitted
   files; null = git status failed: say unknown, never clean). The child has no terminal and runs no git: it works only from that data (and mcp__busyyaks__project(slug)
   for older commits if it needs them) and returns ONLY: shipped (≤ 4 lines, ≤ 10 words each, 1 sha each), uncommitted
   gist (one line, from dirty_paths), flags as {level bad|warn|info, kind, text ≤ 12 words, sha}. Children never count
   or add up lines; say so in each goal. Flags: breaking (migration, removed route/API, required config), security
   (secret, token, auth) — judged from subjects and paths. Upstream repos (own=false): flags only.
   EXACTLY ONE round of children. Never spawn more children to verify, recount or retry; never try to compute
   anything yourself (there is no code tool and no terminal). A child that failed → that repo's shipped lines are
   said missing; the report still goes out.
   Changes (tl:churn) come ONLY from daily_facts.repos[].churn {files, add, del, top}, copied as is; a repo whose
   churn has "error" is left out of tl:churn and listed in the callout.
3. NEEDS YOU: kanban cards waiting for the operator, both lists, Human input first:
   daily_facts.human_input = an agent's open question (question + options are in the entry) → one tl:needs row each:
   title, repo, card id, column "Human input", since, ask = the question in ≤ 12 words (options as "A / B / C").
   daily_facts.human_check = work to check (only the operator moves them on) → call mcp__busyyaks__kanban_card(id), one
   tl:needs row each: title, repo, card id, column "Human Check", since, ask = the decision in ≤ 12 words.
   Add rows (no card) for decisions only the operator can take. Both lists empty → \`ok:0 cards waiting for you\`.
3b. GITHUB NETWORK: call mcp__busyyaks__github_network with hours=24. Its block_markdown is the whole section: copy it
   character for character under "## GitHub network". It holds the operator's GitHub feed (github.com/feed: releases and
   new repos first, then forks / members / tags / stars, pushes per repo, the rest counted — already capped and sorted
   by the tool), then the repos the people they follow starred and the accounts they followed. Never write, add, drop,
   reorder or edit a repo, login, event id, number or line of it — the feed, repos and people come only from that tool.
   It already says "nothing new" when the window is empty and shows the collector's or the feed's error when collection
   failed; add nothing to it.
4. Call mcp__busyyaks__report_components and follow its "Suggested daily layout" exactly, in that order:
   tl:stats with prev → tl:callout (only if something failed or is at risk) → "## Needs you" tl:needs →
   "## At risk" tl:flags → "## Shipped" tl:cards → "## Changes" tl:churn → "## Upstream" →
   "## GitHub network" (step 3b's block, verbatim) → "## Act on" tl:actions.
   tl:stats labels, every day the same: Commits 24h (prev = previous_window.commits, good: up), Repos active
   (prev = previous_window.repos_active, good: up), Uncommitted (pending.dirty_files, good: down), Unpushed
   (pending.unpushed_commits, good: down), No upstream (count of pending.no_upstream_active_own, good: down), Human Check
   (count of human_check). prev for Uncommitted / Unpushed / No upstream = the same label in previous_report.figures;
   no such figure → no prev (unknown, not 0).
   At risk: every repo in pending.no_upstream_active_own with commits is a bad "no upstream" flag; unpushed > 0 is warn;
   then the children's flags; failed last_scan is bad; then one info flag per daily_facts.blocked_external card (kind
   "blocked externally", text "card #<id>" + its reason ≤ 12 words: it waits for the world, never a Needs you row). Empty sections get one inline pill (\`ok:0 cards waiting for you\`,
   \`info:0 upstream flags\`), never a placeholder row. Act on: ≤ 5, command-sized, priority high|med|low.
   End with a tl:kv "Window" row (daily_facts.window from → to).
5. Call mcp__busyyaks__check_report(body_markdown) and fix every broken block it lists until it lists none.
   github_unverified must be empty: if it is not, the GitHub section was changed — paste block_markdown again, unedited.
   Then post ONE report with mcp__busyyaks__post_report: title "Daily report $DAY",
   author "busyyaks-daily (Hermes · $LEAD_MODEL + one $AGENT_MODEL child per repo)".
   With 0 commits in 24h, post anyway: tl:stats saying 0, Needs you, At risk from pending.top.
6. Reply with the report id only.
P

# -z prints only the final reply; Hermes's own log is $home/logs/agent.log. No credentials are passed but the
# busyyaks MCP bearer, which the generated config reads as ${BUSYYAKS_MCP_TOKEN}.
HERMES_HOME="$home" exec "$RUNNER_COMMAND" -z "$PROMPT" --ignore-rules -t delegation,busyyaks --usage-file "$USAGE_FILE"
