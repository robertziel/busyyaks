# Copy to .env (gitignored). Every value is required (compose uses ${VAR:?}), except the optional "Reverse proxy" section at the end.

# Host ports, bound to 127.0.0.1 only. The reverse proxy (deploy/, bin/render-deploy) forwards the public
# hostname to WEB_HOST_PORT; MCP_HOST_PORT is never tunnelled.
WEB_HOST_PORT=8080
MCP_HOST_PORT=8081
# The host address the MCP port is bound to — and the one bin/daily-report and deploy/install-daily-timer.sh call it
# on: an IPv4 loopback address (127.x.x.x). Anything else stops the MCP server and those scripts: it is never exposed.
MCP_HOST=127.0.0.1
# Ports inside the containers (web's puma = HANAMI_PORT, the MCP server = MCP_PORT); compose maps the host ports onto them.
WEB_CONTAINER_PORT=2300
MCP_CONTAINER_PORT=2400

# Web puma (config/puma.rb): threads per process (min, max) and worker processes (0 or 1 = single mode, >1 = cluster).
HANAMI_MIN_THREADS=5
HANAMI_MAX_THREADS=5
HANAMI_WEB_CONCURRENCY=0

# Directory on the host whose immediate children are the git repos to track (mounted read-only).
PROJECTS_ROOT=/path/to/projects
# Where PROJECTS_ROOT appears inside the containers (compose mounts it there; git trusts only repos under it). The
# paths config/busyyaks.yml `roots` lists are under it; bin/launcher maps them back to PROJECTS_ROOT.
PROJECTS_MOUNT=/projects

# The host user the containers run as (compose `user:`): `id -u` and `id -g` of the account that runs bin/launcher.
# ./data (the SQLite file, attachments) and LAUNCHER_RUN_DIR are written by both, so both must be this user; create
# ./data as that user before the first `compose up` (else Docker creates it owned by root). HOST_*, not UID/GID: bash
# makes UID read-only, and the host scripts source this file.
HOST_UID=1000
HOST_GID=1000

# Host directory of bin/launcher's unix socket (launcher.sock, mode 0600) and its clone logs: an absolute path (written
# out: .env values are literal, no $VARS), owned by HOST_UID, mode 0700, OUTSIDE PROJECTS_ROOT and this checkout —
# bin/launcher and deploy/install-launcher.sh refuse one inside (or around) either, because containers mount those and a
# read-only mount does not stop a connect() to a socket. Mounted only into web, mcp and notifier. A PERSISTENT dir (it
# must exist before compose starts those three, at every boot — compose never creates it), e.g. ~/.local/state/busyyaks/run
# written out; deploy/install-launcher.sh creates it, the launcher replaces its stale socket at each start.
LAUNCHER_RUN_DIR=/home/you/.local/state/busyyaks/run

# Timezone for "today" (IANA name).
TZ=UTC

# Session cookie secret (the session also carries the CSRF token, so it is needed with every auth provider): openssl rand -hex 64
# At least 64 bytes: a shorter one stops the web app's boot.
SESSION_SECRET=
# The session cookie's Secure flag: true when the browser reaches the web app over https (behind the TLS proxy of
# docs/DEPLOY.md, which sends X-Forwarded-Ssl: on), false for plain http on localhost / an ssh tunnel. With true, a
# request the app does not see as https gets no session cookie. Exactly true or false; anything else stops the boot.
SESSION_COOKIE_SECURE=false
# The session cookie's SameSite: strict = never sent on a request another site starts (a link to this app from another
# site — a chat, a PR — arrives signed out: the sign-in runs and returns to that page, ?next=); lax = sent on a top-level GET from another site,
# never on its POSTs (every mutation also needs the CSRF token). Exactly strict or lax.
SESSION_COOKIE_SAME_SITE=strict

# --- sign-in: configured in config/busyyaks.yml `auth` (provider none, or a provider directory + its settings), not here.

# Bearer token for the MCP endpoint: openssl rand -hex 32
MCP_TOKEN=
# The daily report's bearer (bin/daily-report, deploy/install-daily-timer.sh, the runner): openssl rand -hex 32, at least
# 32 characters, never MCP_TOKEN. It reaches only the report's tools (reads, check_report, post_report — McpServer::
# REPORT_TOOLS): the report model reads untrusted text (commit subjects, the GitHub feed), so it never gets a tool that
# writes a card or types into a session.
MCP_REPORT_TOKEN=

# Compose profiles every `docker compose` command here starts: empty, or `postgres` to run the compose PostgreSQL
# service with the stack (DATABASE_ADAPTER=postgresql without a server of your own; docker-compose.yml `postgres`).
COMPOSE_PROFILES=

# --- database (lib/busyyaks/database.rb). DATABASE_ADAPTER: sqlite (data/busyyaks.sqlite3, nothing else to run) or
# postgresql. Every key below stays in this file; the adapter's own keys must be filled, the other adapter's may be
# empty. Switching adapters starts an empty database, unless you copy it (SQLite → PostgreSQL:
# bin/db-copy-sqlite-to-postgres, docs/DEPLOY.md).
DATABASE_ADAPTER=sqlite
# sqlite: milliseconds a write waits for the write lock another service holds (web, mcp, scanner, github and notifier
# share the file; WAL, every transaction BEGIN IMMEDIATE — lib/busyyaks/sqlite.rb). Past it the write fails with
# "database is locked". Writes are short; this only has to outlast the longest one (a scan).
SQLITE_BUSY_TIMEOUT_MS=15000
# postgresql: the server. HOST = a host name / address, or the directory of its Unix socket. The compose `postgres`
# service (COMPOSE_PROFILES below): POSTGRES_HOST=/data/postgres-run, POSTGRES_PORT=5432; it creates DB / USER /
# PASSWORD on its first start. The password is read from here only (never put into a URL).
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# postgresql: milliseconds a write waits for the lock another service's transaction holds (every transaction takes one
# advisory lock — lib/busyyaks/postgres.rb); past it the write fails with "canceling statement due to lock timeout".
# The twin of SQLITE_BUSY_TIMEOUT_MS; e.g. 15000.
POSTGRES_LOCK_TIMEOUT_MS=

# Seconds between repo scans.
SCAN_INTERVAL_SECONDS=60

# --- GitHub network (compose service `github`, bin/github): what the people GITHUB_LOGIN follows star and whom they
# follow, shown on /github, by the MCP tool github_network and in the daily report. Token: read-only public data is
# enough (`gh auth token`, or a fine-grained token with no repository access). Only the github service gets it.
GITHUB_LOGIN=your-github-login
GITHUB_TOKEN=
# Seconds between collections (conditional requests: unchanged pages cost no rate limit).
GITHUB_INTERVAL_SECONDS=3600
# Seconds between PR polls: check status for the kanban idle watch (config/kanban.yml idle_watch; notifier reads) and PR state for
# the card links' flags (open · draft · merged · closed; web reads). The github service answers; an answer older than 3x
# this is "unavailable". Private repos (a private local repo's PRs) need the token to read them.
GITHUB_CI_INTERVAL_SECONDS=60

# Reading a scanned repo (every service: scan, the card links, the daily facts' churn, the idle watch's branch): one
# short-lived child per read, bin/git-read (libgit2 — it never runs a program a repo's config names). A crafted repo
# can still make a read hang or grow, so each child has hard limits; past one, that repo's read fails loudly (the
# scan's error, the card's links), never a guess and never the git CLI instead.
#   GIT_READ_TIMEOUT_SECONDS  wall clock per read, then the child is killed
#   GIT_READ_CPU_SECONDS      CPU seconds per read (RLIMIT_CPU)
#   GIT_READ_MEMORY_BYTES     address space per read (RLIMIT_AS), at least 134217728 (the child is a Ruby VM)
#   GIT_READ_MAX_BLOB_BYTES   a file larger than this is never loaded: it counts as binary (0 lines) and is said so
GIT_READ_TIMEOUT_SECONDS=30
GIT_READ_CPU_SECONDS=30
GIT_READ_MEMORY_BYTES=1073741824
GIT_READ_MAX_BLOB_BYTES=10485760
# compose mem_limit of web · mcp · scanner · notifier: the ceiling over everything a service runs, its git-read
# children included (docker syntax: 2g, 1536m)
SERVICE_MEM_LIMIT=2g

# --- daily report: configured in config/busyyaks.yml `daily_report` (schedule, gateway, models, runner), not here.

# --- agent-session collector (agents sidebar, typing card comments into sessions): configured in config/busyyaks.yml
# `agents.collector` (none, or its snapshot file + read socket), not here.

# "Open terminal" target for a tmux team session ({session}, {socket} substituted, URL-encoded), e.g. an agent
# terminal UI, which shows and types into agent sessions.
TEAM_TERMINAL_URL="https://chat.example.com/code/#s={session}&sock={socket}"

# "Open in Claude": bin/launcher reads Claude Code's live session records (one JSON per process: tmux pane +
# bridgeSessionId, the Remote Control session) and links {id} into this template.
CLAUDE_SESSIONS_DIR=/home/you/.claude/sessions
CLAUDE_SESSION_URL="https://claude.ai/code/{id}"

# bin/launcher's own state: created.json, the repos its "new repo" (git init, never a clone) made and whose
# folder-trust prompt it answers (config/busyyaks.yml launch). Absolute, written out, owned by HOST_UID, 0700 (the
# launcher creates it), outside every dir a container mounts (PROJECTS_ROOT, this checkout and ./data, the launcher
# socket dir): the launcher refuses anything else. No container sees it, so none can mark a repo trusted.
LAUNCHER_STATE_DIR=/home/you/.local/state/busyyaks/launcher

# "iTerm" copy button: the command that attaches to a team's tmux session from your own machine ({session}).
SSH_ATTACH_TEMPLATE="ssh -t your-host tmux attach -t {session}"

# Card notifier (compose service `notifier`): new comments on a card are typed into its owner tmux session;
# the watchdog releases cards whose owner session has been gone for WATCHDOG_GRACE_SECONDS — and a session the board
# just launched counts as running (against config/kanban.yml's concurrency cap) for that long before tmux lists it.
NOTIFIER_INTERVAL_SECONDS=5
NOTIFIER_WATCH_SECONDS=30
WATCHDOG_GRACE_SECONDS=60

# Card attachments (files under ./data/attachments/<card_id>/, random names on disk). Max bytes per file, and the
# allowlist: MIME types (each enables its extensions) and/or bare extensions, comma-separated. The type is read from
# the bytes and must match the extension. Known: image/png image/jpeg image/gif image/webp image/svg+xml application/pdf
# application/zip application/gzip video/mp4 text/html text/plain(.txt .log) text/markdown text/csv application/json
# text/yaml text/x-diff. Pictures (png/jpeg/gif/webp) show inline; everything else (SVG, HTML too) only downloads.
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_TYPES=image/png,image/jpeg,image/gif,image/webp,image/svg+xml,application/pdf,application/zip,application/gzip,video/mp4,text/plain,text/markdown,text/csv,application/json,text/yaml,text/x-diff

# Reverse proxy: OPTIONAL. Leave these empty for the default localhost-only setup. bin/render-deploy fills
# deploy/*.template from them into deploy/rendered/ (gitignored). See docs/DEPLOY.md.
# Public hostname nginx serves, e.g. busyyaks.example.com. The web app reads it too: the Hosts it answers are
# 127.0.0.1:<WEB_HOST_PORT>, localhost:<WEB_HOST_PORT> and this one (https) — any other Host is 421 (DNS rebinding,
# lib/busyyaks/host_guard.rb). The key must be present; empty = loopback only. Not allowed with auth provider none.
# Also the dashboard's origin in every card's `url` the kanban MCP tools return: https://PUBLIC_HOST, or
# http://127.0.0.1:WEB_HOST_PORT while it is empty (lib/busyyaks/dashboard_url.rb).
PUBLIC_HOST=
# TLS certificate and key on the proxy host, e.g. /etc/letsencrypt/live/busyyaks.example.com/fullchain.pem and privkey.pem
TLS_CERT_PATH=
TLS_KEY_PATH=
# host:port nginx proxies to: 127.0.0.1:<WEB_HOST_PORT> on the same host, or the frps vhost_http_port (tunnel)
PROXY_UPSTREAM=
# Tunnel only (deploy/frpc-busyyaks.ini.template): the subdomain under frps' subdomain_host, e.g. busyyaks
FRPC_SUBDOMAIN=
