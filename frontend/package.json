{
  "name": "busyyaks-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 --report-unused-disable-directives .",
    "format": "cd .. && prettier --write \"**/*.{ts,tsx,js,css,json}\"",
    "format:check": "cd .. && prettier --check \"**/*.{ts,tsx,js,css,json}\""
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
