# Prettier reads this too (end_of_line, indent); .prettierrc.json sets printWidth 120.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# the files of ours written with 4 spaces (PEP 8; this one script) — what they are, not a new style
[*.py]
indent_size = 4

[scripts/vendor-kanban-engine.sh]
indent_size = 4
