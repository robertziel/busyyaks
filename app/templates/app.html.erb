<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="<%= h.e(csrf) %>">
<meta name="user-email" content="<%= h.e(email) %>">
<meta name="sign-out" content="<%= h.e(sign_out) %>">
<meta name="setup" content="<%= h.e(setup) %>">
<meta name="color-scheme" content="light dark">
<title>busyyaks</title>
<link rel="icon" href="<%= h.asset("/static/icon.svg") %>">
<script src="<%= h.asset("/static/skin.js") %>"></script>
<link rel="stylesheet" href="<%= h.asset("/static/app.css") %>">
<style><%= theme_css %></style>
<%- css.each do |f| -%>
<link rel="stylesheet" href="<%= h.e(f) %>">
<%- end -%>
<%- scripts.each do |s| -%>
<script src="<%= h.e(s) %>" defer></script>
<%- end -%>
<script type="module" src="<%= h.e(js) %>"></script>
</head>
<body>
<div id="root"></div>
</body>
</html>
