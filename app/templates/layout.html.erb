<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="<%= csrf %>">
<title><%= h.e(title) %> · busyyaks</title>
<link rel="icon" href="<%= h.asset("/static/icon.svg") %>">
<script src="<%= h.asset("/static/skin.js") %>"></script>
<link rel="stylesheet" href="<%= h.asset("/static/app.css") %>">
<%- scripts.each do |s| -%>
<script src="<%= h.e(s) %>" defer></script>
<%- end -%>
</head>
<body>
<header class="top"><div class="in">
  <a class="brand" href="/" aria-label="busyyaks"><img class="logo-light" src="<%= h.asset("/static/logo-light-animated.svg") %>" alt="busyyaks"><img class="logo-dark" src="<%= h.asset("/static/logo-dark-animated.svg") %>" alt="busyyaks"></a>
  <span class="spacer"></span>
  <div data-auth-launcher></div>
</div></header>
<main class="wrap">
<%= content %>
</main>
</body>
</html>
