#!/usr/bin/env bash
# The README screenshots' stage (busyyaks's and the kanban module's): a throwaway busyyaks stack built from this
# checkout, on SYNTHETIC data only — generated repos under acme/* with a year of commits by dev@example.com and a
# teammate, a fresh database, auth none on 127.0.0.1, and the real bin/launcher in its own container, whose tmux server
# runs the sessions seed.js Launches (lead first) as stand-in agents (scripts/readme-images/agent) drawing Claude Code
# screens, read through a stand-in collector (scripts/readme-images/collector). Nothing of a real deployment is read.
#
#   scripts/readme-images/demo-stack up <workdir> [--from <dumpdir>]   build + start (prints the web and MCP URLs)
#   scripts/readme-images/demo-stack down <workdir>   stop and remove the containers (workdir kept)
#
# Then scripts/readme-images/build <workdir> <module checkout> seeds the demo and captures the images.
#
# --from <dumpdir> (scripts/readme-images/dump: busyyaks' own board, renamed and gated): the README's busyyaks stage.
# Two more repos, `busyyaks` (the dump's commit subjects of the last year, on its working branch `local`) and
# `busyyaks_kanban_engine`, both enrolled as own-mode local repos with the demo's remotes (dev-example/<name>_dev →
# dev-example/<name>, the names dump.js gives their PRs); the dump mounted read-only into web at /dump, where build
# loads it (load-dump.rb) before seeding.
# Ports: README_DEMO_WEB_PORT / README_DEMO_MCP_PORT (both required, free ports on 127.0.0.1). The workdir: at most 80
# bytes, and no dir above it writable by group / other (bin/launcher refuses a socket dir under e.g. /tmp) — e.g.
# ~/.local/state/readme-demo.
set -euo pipefail

PROJECT=readme-demo
IMAGE=busyyaks:readme-demo
LAUNCHER_IMAGE=busyyaks:readme-demo-launcher
REPOS=(acme/storefront acme/payments-api acme/mobile-app acme/docs-site acme/infra)

die() { echo "demo-stack: $*" >&2; exit 1; }

compose() {
  local w=$1; shift
  docker compose -p "$PROJECT" --project-directory "$w" --env-file "$w/.env" \
    -f "$(cat "$w/checkout")/docker-compose.yml" -f "$w/override.yml" "$@"
}

# One repo with a year of commits (git fast-import: a few a day on weekdays, fewer at weekends, by the demo author and,
# one in four, a teammate); origin points at github.com/acme/<name> (never fetched). $3 varies the pattern per repo.
make_repo() {
  local w=$1 slug=$2 seed=$3
  docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$w/projects:/p" -w /p --entrypoint sh "$IMAGE" -euc '
    slug=$1; seed=$2; mkdir -p "$slug"; cd "$slug"
    git init -q -b main
    git remote add origin "https://github.com/$slug.git"
    awk -v now="$(date +%s)" -v seed="$seed" -v slug="$slug" "BEGIN {
      split(\"Fix the flaky checkout test|Cache the product query|Add pagination to the listing|Bump dependencies|Refactor the price formatter|Log slow requests|Handle empty carts|Tidy the README|Add a health check|Retry failed webhooks\", subj, \"|\")
      mark = 1
      for (d = 364; d >= 0; d--) {
        day = now - d * 86400
        dow = int(day / 86400 + 4) % 7
        n = (d * 7919 + seed * 104729 + d * d * 31) % 9
        n = (n > 5 ? n - 5 : 0) + (d < 14 ? 2 : 0)
        if (dow == 0 || dow == 6) n = int(n / 3)
        for (k = 0; k < n; k++) {
          t = day - 3600 * (k + 1) - seed * 60
          who = ((d + k + seed) % 4 == 0) ? \"Sam Teammate <teammate@example.com>\" : \"Dev Example <dev@example.com>\"
          msg = subj[(d + k * 3 + seed) % 10 + 1]
          body = \"change \" d \".\" k \"\\n\"
          print \"blob\"; print \"mark :\" mark; print \"data \" length(body) + 0; printf \"%s\", body; print \"\"
          print \"commit refs/heads/main\"; print \"author \" who \" \" t \" +0000\"; print \"committer \" who \" \" t \" +0000\"
          print \"data \" length(msg); print msg
          print \"M 100644 :\" mark \" CHANGELOG.md\"; print \"\"
          mark++
        }
      }
    }" | git fast-import --quiet
    git checkout -q main' sh "$slug" "$seed"
}

# busyyaks' own repo from a dump: its commit subjects (commits.tsv: <epoch>\t<subject>, newest first) replayed oldest
# first on `local` by the demo author, each moved forward by the dump's age ($5 s: the board's times move the same),
# `main` at the same tip; enrolled like the live checkout (the guard.*
# keys the scanner reads) with the demo's remotes, so the board reads the dump's local and public PRs as this repo's.
make_dump_repo() {
  local w=$1 slug=$2 public=$3 commits=$4 shift=$5
  docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$w/projects:/p" -v "$commits:/commits.tsv:ro" -w /p \
    --entrypoint sh "$IMAGE" -euc '
    slug=$1; public=$2; shift=$3; mkdir -p "$slug"; cd "$slug"
    git init -q -b local
    git remote add origin "https://github.com/dev-example/${public}_dev.git"
    git remote add upstream "https://github.com/dev-example/$public.git"
    git config guard.mode own
    git config guard.mirrorRemote origin
    git config guard.upstreamRemote upstream
    git config guard.publicRemote upstream
    git config guard.localBranch local
    git config guard.publicBase upstream/main
    # bytes, not characters (fast-import counts bytes); the subject = everything after the first tab
    tac /commits.tsv | LC_ALL=C awk -F "\t" -v shift="$shift" "BEGIN { mark = 1 }
      NF >= 2 && \$1 ~ /^[0-9]+\$/ {
        msg = substr(\$0, index(\$0, \"\\t\") + 1); body = \"change \" mark \"\\n\"
        print \"blob\"; print \"mark :\" mark; print \"data \" length(body) + 0; printf \"%s\", body; print \"\"
        t = \$1 + shift
        print \"commit refs/heads/local\"; print \"author Dev Example <dev@example.com> \" t \" +0000\"
        print \"committer Dev Example <dev@example.com> \" t \" +0000\"
        print \"data \" length(msg); print msg
        print \"M 100644 :\" mark \" CHANGELOG.md\"; print \"\"
        mark++
      }" | git fast-import --quiet
    [ "$(git rev-list --count local)" -gt 0 ] || { echo "demo-stack: no commit in the dump for $slug" >&2; exit 1; }
    git branch -q main local
    git update-ref refs/remotes/upstream/main local
    # work in flight, as on a working checkout: the last 2 commits not pushed yet, one file not committed
    git config branch.local.remote origin
    git config branch.local.merge refs/heads/local
    if [ "$(git rev-list --count local)" -gt 2 ]; then git update-ref refs/remotes/origin/local local~2; else git update-ref refs/remotes/origin/local local; fi
    git checkout -q local
    echo "notes in progress" > NOTES.md' sh "$slug" "$public" "$shift"
}

up() {
  local checkout w dump=
  checkout=$(cd "$(dirname "$0")/../.." && pwd)
  mkdir -p "${1:?workdir}"
  w=$(cd "$1" && pwd)
  if [ "${2:-}" = --from ]; then
    dump=$(cd "${3:?--from <dumpdir>}" && pwd)
    for f in board.json card commits.tsv merged.json attachments; do
      [ -e "$dump/$f" ] || die "$dump has no $f: not a dump (scripts/readme-images/dump)"
    done
  elif [ -n "${2:-}" ]; then
    die "usage: $0 up <workdir> [--from <dumpdir>]"
  fi
  : "${README_DEMO_WEB_PORT:?a free port for the demo web app}" "${README_DEMO_MCP_PORT:?a free port for the demo MCP}"
  # the collector's read socket lives under it: a unix socket path has at most 107 bytes
  [ "${#w}" -le 80 ] || die "workdir path $w is longer than 80 bytes: pick a shorter one (a unix socket goes under it)"
  [ -e "$w/data" ] && die "$w/data exists: use a fresh workdir (down + rm -rf it first)"
  # build's markers belong to the stack they were made on: one left over would skip a load or a seed
  local m
  for m in dump loaded seeded seeded-busyyaks; do
    [ -e "$w/$m" ] && die "$w/$m exists (left from another stage): use a fresh workdir (down + rm -rf it first)"
  done
  echo "$checkout" > "$w/checkout"

  docker build -q -t "$IMAGE" "$checkout" >/dev/null
  # tmux + the stand-in agent on PATH (its file is mounted from the workdir's collector dir, filled below)
  printf 'FROM %s\nRUN apt-get update -qq && apt-get install -y -qq --no-install-recommends tmux >/dev/null && rm -rf /var/lib/apt/lists/*\nRUN ln -s %s/collector/agent /usr/local/bin/readme-agent\n' \
    "$IMAGE" "$w" | docker build -q -t "$LAUNCHER_IMAGE" - >/dev/null

  mkdir -p "$w/projects" "$w/data" "$w/config" "$w/session-records" "$w/collector"
  : > "$w/git-ignore"   # GIT_EXCLUDES_FILE: an empty global excludes file
  # the launcher's socket dir and state dir: outside ./data, PROJECTS_ROOT and the checkout, this uid, 0700, under one
  # parent of this uid that the launcher container mounts as a whole (bin/launcher checks the parent's owner too)
  mkdir -p "$w/launcher/run" "$w/launcher/state"
  chmod 0700 "$w/launcher" "$w/launcher/run" "$w/launcher/state"
  local i=0
  for r in "${REPOS[@]}"; do i=$((i + 1)); make_repo "$w" "$r" "$i"; done
  local repos=("${REPOS[@]}")
  if [ -n "$dump" ]; then
    echo "$dump" > "$w/dump"
    local at age
    at=$(grep -o '"exported_at":[0-9]*' "$dump/board.json" | cut -d: -f2)
    [ -n "$at" ] || die "$dump/board.json has no exported_at"
    age=$(( $(date +%s) - at ))
    make_dump_repo "$w" busyyaks busyyaks "$dump/commits.tsv" "$age"
    # the engine: its own enrolled repo (the dump's cards hold its PRs too); its history is not the README's subject:
    # one commit, a month before the dump
    printf '%s\tVendor the kanban engine\n' "$((at - 30 * 86400))" > "$w/engine-commits.tsv"
    make_dump_repo "$w" busyyaks_kanban_engine busyyaks_agents_kanban_module "$w/engine-commits.tsv" "$age"
    repos+=(busyyaks busyyaks_kanban_engine)
  fi

  cp "$checkout/config/kanban.example.yml" "$w/config/kanban.yml"
  cat > "$w/config/busyyaks.yml" <<YML
roots:
  - { path: /projects, prefix: "" }
search_depth: 2
owner_remotes: [github.com/acme/, github.com/dev-example/]
author_emails: [dev@example.com]
window_days: 7
auth: { provider: none, allow_unauthenticated: true }
reap_protect: []
agents: { collector: { snapshot: $w/collector/snapshot.json, read_socket: $w/collector/read.sock, tmux_timeout_seconds: 5, answer_timeout_seconds: 30 } }
terminal: { public_host: deny, max_open: 4 }
skills: { max_bytes: 65536, max_start_bytes: 32768, project: deny, local_dir: null }
github_hook: none
updates: { remote: origin, branch: main, tags: "v*", channel: tags, check_minutes: 360 }
ci:
  max_pending_minutes: 60
  required:
    acme/storefront: [ci]
launch:
  trusted_paths: []
  start_seconds: 30
  scopes: null # the stage's launcher container runs no systemd user manager
  commands:
    # the stand-in agent (scripts/readme-images/agent, readme-agent on the launcher image's PATH): seed.js makes it
    # every agent type's launcher, so the real bin/launcher starts the board's lead and its workers through Launch
    - { kind: hermes, command: readme-agent, args: [], via_shell: false }
YML
  # every key compose requires from busyyaks's .env.example (it refuses a missing one): a key added there is added here
  # too (test/unit/readme_demo_stack_test.rb). Left out: the reverse-proxy section's TLS_*, PROXY_UPSTREAM,
  # FRPC_SUBDOMAIN, which only bin/render-deploy reads, and the CI-only CI_GITHUB_*
  cat > "$w/.env" <<ENV
WEB_HOST_PORT=$README_DEMO_WEB_PORT
MCP_HOST_PORT=$README_DEMO_MCP_PORT
MCP_HOST=127.0.0.1
PUBLIC_HOST=
LAUNCHER_RUN_DIR=$w/launcher/run
LAUNCHER_STATE_DIR=$w/launcher/state
WEB_CONTAINER_PORT=2300
MCP_CONTAINER_PORT=2400
HANAMI_MIN_THREADS=5
HANAMI_MAX_THREADS=5
HANAMI_WEB_CONCURRENCY=0
PROJECTS_ROOT=$w/projects
PROJECTS_MOUNT=/projects
GIT_EXCLUDES_FILE=$w/git-ignore
HOST_UID=$(id -u)
HOST_GID=$(id -g)
TZ=UTC
SESSION_SECRET=$(head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n')
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict
MCP_TOKEN=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
MCP_REPORT_TOKEN=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
MCP_BOARD_TOKEN=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
COMPOSE_PROFILES=
DATABASE_ADAPTER=sqlite
SQLITE_BUSY_TIMEOUT_MS=15000
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_LOCK_TIMEOUT_MS=
GITHUB_WEBHOOK_SECRET=
TEAM_TERMINAL_URL="https://terminal.example.com/#s={session}&sock={socket}"
CLAUDE_SESSIONS_DIR=$w/session-records
CLAUDE_SESSION_URL="https://claude.example.com/{id}"
SSH_ATTACH_TEMPLATE="ssh -t box.example.com tmux attach -t {session}"
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_TYPES=image/png,image/jpeg,image/webp
GIT_READ_TIMEOUT_SECONDS=30
GIT_READ_CPU_SECONDS=30
GIT_READ_MEMORY_BYTES=1073741824
GIT_READ_MAX_BLOB_BYTES=10485760
SERVICE_MEM_LIMIT=2g
DICTATION_URL=
DICTATION_TOKEN=
TEST_WORKERS=1
ENV
  cat > "$w/override.yml" <<YML
services:
  web: { image: $IMAGE, restart: "no"${dump:+, volumes: ["$dump:/dump:ro"]} }
  mcp: { image: $IMAGE, restart: "no" }
  scanner: { image: $IMAGE, restart: "no" }
  notifier: { image: $IMAGE, restart: "no" }
  writer: { image: $IMAGE, restart: "no" }
  github: { image: $IMAGE, restart: "no" }   # never the live busyyaks:local, if anyone starts it (the demo does not)
  launcher:
    image: $LAUNCHER_IMAGE
    network_mode: none
    user: "$(id -u):$(id -g)"
    restart: "no"
    environment: { HOME: /tmp }
    entrypoint: ["sh", "-c"]
    # the stand-in agent sessions (idle shells in the repos, in this container's own tmux server) and a stand-in
    # agent-session collector (scripts/readme-images/collector), then the real bin/launcher
    command: ["sh $w/collector/run && exec bin/launcher"]
    volumes:
      - $w/.env:/app/.env:ro
      - $w/config/busyyaks.yml:/app/config/busyyaks.yml:ro
      - $w/config/kanban.yml:/app/config/kanban.yml:ro
      - $w/data:/app/data
      - $w/projects:$w/projects:ro
      - $w/session-records:$w/session-records:ro
      - $w/collector:$w/collector
      - $w/launcher:$w/launcher
YML
  sed "s|@COLLECTOR@|$w/collector|" "$(dirname "$0")/collector" > "$w/collector/run"
  sed "s|@COLLECTOR@|$w/collector|" "$(dirname "$0")/agent" > "$w/collector/agent"
  chmod +x "$w/collector/agent"
  mkdir -p "$w/collector/screens" "$w/collector/kinds"
  compose "$w" up -d --no-build launcher
  for _ in $(seq 1 30); do [ -S "$w/launcher/run/launcher.sock" ] && break; sleep 1; done
  [ -S "$w/launcher/run/launcher.sock" ] || { compose "$w" logs launcher >&2; die "launcher socket never appeared"; }
  # web first: it migrates the fresh database (bin/web); the scanner and the MCP server read it, so they start after /up
  compose "$w" up -d --no-build web
  for _ in $(seq 1 60); do curl -fsS "http://127.0.0.1:$README_DEMO_WEB_PORT/up" >/dev/null 2>&1 && break; sleep 1; done
  curl -fsS "http://127.0.0.1:$README_DEMO_WEB_PORT/up" >/dev/null || { compose "$w" logs web >&2; die "web never answered /up"; }
  # the notifier: pings, the watch pass, and the session dialogs it turns into questions on the cards
  # the writer: a board's shape is saved through it (seed.js gives a demo board the local-repo workflow)
  compose "$w" up -d --no-build mcp scanner notifier writer
  # the scanner's first pass: every demo repo is a project before anything seeds its board
  local api="http://127.0.0.1:$README_DEMO_WEB_PORT/api/projects" r ok
  for _ in $(seq 1 90); do
    ok=1
    for r in "${repos[@]}"; do curl -fsS "$api" | grep -q "\"slug\":\"$r\"" || ok=0; done
    [ "$ok" = 1 ] && break
    sleep 1
  done
  [ "$ok" = 1 ] || { compose "$w" logs scanner >&2; die "the scanner never listed every demo repo"; }
  echo "web http://127.0.0.1:$README_DEMO_WEB_PORT  mcp http://127.0.0.1:$README_DEMO_MCP_PORT/mcp"
}

down() {
  local w
  w=$(cd "${1:?workdir}" && pwd)
  compose "$w" down --remove-orphans
}

case "${1:-}" in
  up) shift; up "$@" ;;
  down) shift; down "$@" ;;
  *) die "usage: $0 up <workdir> [--from <dumpdir>] | down <workdir>" ;;
esac
