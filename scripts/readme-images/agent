#!/bin/sh
# The demo stack's stand-in agent program (readme-agent on the launcher image's PATH; scripts/readme-images/demo-stack
# copies it into the workdir, @COLLECTOR@ filled): the command of the demo's one launcher (kind hermes in the demo's
# launch.commands, made every type's launcher by seed.js), so the board's lead and its workers are started by the real
# bin/launcher through Launch — and no agent runs. It ignores the argv Launch gives it (-q <prompt>) and draws, in its
# tmux pane the Claude Code screen build gave its session (@COLLECTOR@/screens/<session>: thinking, a running tool, a
# permission dialog, idle — scripts/readme-images/screens/), which bin/launcher reads as it reads a real agent's pane.
# No screen = it exits naming the file, and bin/launcher's start check refuses the launch.
# {elapsed} in a screen = the time since this agent started (its one turn began at Launch), as Claude Code's status line
# counts a turn: what its session wrote on a card since stays inside the turn (the card dialog shows it at work there).
# {tokens} = the turn's ↓ count, rising 0.1k a second from 2.0k: output streaming, which bin/launcher reads as writing
# (Busyyaks::AgentActivity.settle: the count rose between two reads of the pane).
# Its sleep child keeps the launcher's start check satisfied.
# Kind hermes: bin/launcher's start check asks `<command> skills list` in the session's own environment whether the
# per-launch entry skill is listed (docs/DEPLOY.md § Skills). The stand-in answers as hermes would with the
# `${BUSYYAKS_SKILLS_DIR}/busyyaks-skills` external_dirs line: every skill dir the launch staged, enabled.
if [ "$1" = skills ] && [ "$2" = list ]; then
  d=${BUSYYAKS_SKILLS_DIR:?readme-agent: BUSYYAKS_SKILLS_DIR unset: the launch staged no skills}/busyyaks-skills
  [ -d "$d" ] || { echo "readme-agent: no staged skills at $d" >&2; exit 1; }
  for s in "$d"/*/; do
    [ -f "$s/SKILL.md" ] && printf '| %s | busyyaks | enabled |\n' "$(basename "$s")"
  done
  exit 0
fi
screens=@COLLECTOR@/screens
session=$(tmux display-message -p '#S')
start=$(date +%s)
shown=""
while :; do
  f="$screens/$session"
  t=$(($(date +%s) - start))
  if [ ! -r "$f" ]; then
    echo "readme-agent: no screen for session $session ($f; scripts/readme-images/build writes it before seeding)" >&2
    exit 1
  fi
  k=$((20 + t))
  now=$(sed -e "s/{elapsed}/$((t / 60))m $((t % 60))s/" -e "s/{tokens}/$((k / 10)).$((k % 10))k/" "$f")
  if [ "$now" != "$shown" ]; then
    clear
    printf '%s\n' "$now"
    shown=$now
  fi
  sleep 1
done
