#!/usr/bin/env bash
# The harness contract: builds the pinned image, then runs the real Claude Code, Hermes and Codex CLIs in
# tmux against the scripted mock, with no network. usage: scripts/harness-lab/run <new output dir> [claude hermes codex]
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
out=${1:?usage: run <new output dir> [harness ...]}
shift
[ ! -e "$out" ] || { echo "harness-lab: $out already exists" >&2; exit 2; }
mkdir -p "$(dirname "$out")"
mkdir -m 700 "$out"
image=busyyaks:harness-lab-$(sha256sum < "$here/Dockerfile" | cut -c1-12)
docker build -q -t "$image" "$here" >/dev/null
docker run --rm --network none --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$here":/lab:ro -v "$(cd "$out" && pwd)":/out "$image" ruby /lab/contract /out "$@"
