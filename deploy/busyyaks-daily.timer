# systemd --user timer; installed by deploy/install-daily-timer.sh. Ticks all day (Settings → Daily report schedule):
# the first tick that finds the gateway up runs the report, later ticks exit.
[Unit]
Description=busyyaks daily report tick

[Timer]
OnCalendar=__ON_CALENDAR__
Persistent=false

[Install]
WantedBy=timers.target
